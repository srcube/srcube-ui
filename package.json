{
  "name": "srcube-ui",
  "version": "0.0.0",
  "description": "A UI library",
  "keywords": [
    "UI",
    "React UI",
    "MiniProgram UI"
  ],
  "author": "chioio",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "turbo run dev",
    "dev:pkg": "turbo run dev --filter=./packages/**",
    "dev:mini": "pnpm -C apps/sample-mini dev",
    "dev:react": "pnpm -C apps/sample-react dev",
    "dev:docs": "pnpm -C apps/docs dev",
    "build": "turbo run build",
    "build:pkg": "turbo run build --filter=./packages/**",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "miniprogram-api-typings": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "jsdom": "catalog:",
    "miniprogram-simulate": "catalog:",
    "@vitest/browser-preview": "catalog:",
    "vitest-browser-react": "catalog:"
  }
}
