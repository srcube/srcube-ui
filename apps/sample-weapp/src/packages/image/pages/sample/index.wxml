<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <sr-navbar
    className="sticky top-0 z-20 border-b border-slate-200"
    title="Image"
    withBack="{{true}}"
    hasSafeTop="{{true}}"
  />

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Basic / State</view>
      <view class="mt-3 grid grid-cols-3 gap-3">
        <view>
          <sr-image src="{{coverUrl}}" className="w-full aspect-square" />
        </view>
        <view>
          <sr-image
            src="https://invalid.srcube-ui.dev/fail.png"
            fallback="Load failed"
            className="w-full aspect-square"
          />
        </view>
        <view>
          <sr-image fallback="No src" className="w-full aspect-square" />
        </view>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Ratio / Radius / Fit</view>
      <view class="mt-1 text-xs text-slate-500">
        use ButtonGroup to switch ratio, radius and fit
      </view>
      <view class="mt-3 space-y-2">
        <sr-button-group size="sm" isBlock>
          <block wx:for="{{ratioOptions}}" wx:key="value" wx:for-item="option">
            <sr-button
              color="{{ratioMode === option.value ? 'primary' : 'default'}}"
              variant="{{ratioMode === option.value ? 'solid' : 'flat'}}"
              data-value="{{option.value}}"
              bind:tap="handleRatioModeTap"
            >
              {{option.label}}
            </sr-button>
          </block>
        </sr-button-group>

        <sr-button-group size="sm" isBlock>
          <block wx:for="{{radiusOptions}}" wx:key="value" wx:for-item="option">
            <sr-button
              color="{{radiusMode === option.value ? 'primary' : 'default'}}"
              variant="{{radiusMode === option.value ? 'solid' : 'flat'}}"
              data-value="{{option.value}}"
              bind:tap="handleRadiusModeTap"
            >
              {{option.label}}
            </sr-button>
          </block>
        </sr-button-group>

        <sr-button-group size="sm" isBlock>
          <block wx:for="{{fitOptions}}" wx:key="value" wx:for-item="option">
            <sr-button
              color="{{fitMode === option.value ? 'primary' : 'default'}}"
              variant="{{fitMode === option.value ? 'solid' : 'flat'}}"
              data-value="{{option.value}}"
              bind:tap="handleFitModeTap"
            >
              {{option.label}}
            </sr-button>
          </block>
        </sr-button-group>
      </view>
      <view class="mt-3">
        <sr-image
          is-block="{{true}}"
          ratio="{{ratioMode}}"
          radius="{{radiusMode}}"
          fit="{{fitMode}}"
          src="{{ratioPreviewUrl}}"
        />
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Preview</view>
      <view class="mt-3 grid grid-cols-2 gap-3">
        <view>
          <sr-image
            src="{{coverUrl}}"
            is-previewable="{{true}}"
            className="w-full aspect-square"
            preview-urls="{{previewUrls}}"
          />
        </view>
        <view>
          <sr-image
            src="{{photoUrl}}"
            ratio="square"
            is-previewable="{{true}}"
            preview-src="{{photoUrl}}"
          />
        </view>
      </view>
    </view>
  </view>
</view>
