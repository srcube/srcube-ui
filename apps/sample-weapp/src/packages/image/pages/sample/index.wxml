<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <sr-navbar
    className="sticky top-0 z-20 border-b border-slate-200"
    title="Image"
    withBack="{{true}}"
    hasSafeTop="{{true}}"
  />

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Basic / State</view>
      <view class="mt-3 grid grid-cols-3 gap-3">
        <view>
          <sr-image src="{{coverUrl}}" />
        </view>
        <view>
          <sr-image src="https://invalid.srcube-ui.dev/fail.png" fallback="Load failed" />
        </view>
        <view>
          <sr-image fallback="No src" />
        </view>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Ratio / Radius / Fit</view>
      <view class="mt-3 space-y-3">
        <view>
          <sr-image is-block="{{true}}" ratio="video" radius="lg" src="{{videoUrl}}" />
        </view>
        <view>
          <sr-image
            is-block="{{true}}"
            ratio="photo"
            fit="contain"
            radius="sm"
            src="{{photoUrl}}"
          />
        </view>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Preview</view>
      <view class="mt-3 grid grid-cols-2 gap-3">
        <view>
          <sr-image
            src="{{coverUrl}}"
            is-previewable="{{true}}"
            preview-urls="{{previewUrls}}"
          />
        </view>
        <view>
          <sr-image
            src="{{photoUrl}}"
            ratio="square"
            is-previewable="{{true}}"
            preview-src="{{photoUrl}}"
          />
        </view>
      </view>
    </view>
  </view>
</view>
