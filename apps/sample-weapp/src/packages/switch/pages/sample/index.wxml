<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <sr-navbar
    className="sticky top-0 z-20 border-b border-slate-200"
    title="Switch"
    withBack="{{true}}"
    hasSafeTop="{{true}}"
  />

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Colors</view>
      <view class="mt-1 text-xs text-slate-500">color + controlled</view>
      <view class="mt-3 flex flex-col gap-3">
        <sr-switch
          wx:for="{{colors}}"
          wx:key="value"
          data-value="{{item.value}}"
          color="{{item.value}}"
          isSelected="{{item.value === colorValue}}"
          bind:change="handleColorChange"
        >
          {{item.label}}
        </sr-switch>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Sizes</view>
      <view class="mt-1 text-xs text-slate-500">size + controlled</view>
      <view class="mt-3 flex flex-col gap-3">
        <sr-switch
          wx:for="{{sizes}}"
          wx:key="value"
          data-value="{{item.value}}"
          size="{{item.value}}"
          isSelected="{{item.value === sizeValue}}"
          bind:change="handleSizeChange"
        >
          {{item.label}}
        </sr-switch>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Custom Icon</view>
      <view class="mt-1 text-xs text-slate-500">Iconify className</view>
      <view class="mt-3 flex flex-col gap-3">
        <sr-switch defaultSelected hasIcon>
          <view slot="icon" class="icon-[ion--checkmark] text-primary text-sm" />
          Check
        </sr-switch>
        <sr-switch defaultSelected hasIcon>
          <view slot="icon" class="icon-[ion--flash] text-warning text-sm" />
          Flash
        </sr-switch>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">States</view>
      <view class="mt-3 flex flex-col gap-3">
        <sr-switch isSelected="{{isEnabled}}" bind:change="handleEnabledChange">
          Controlled
        </sr-switch>
        <sr-switch isDisabled>Disabled</sr-switch>
        <sr-switch isReadOnly defaultSelected>ReadOnly</sr-switch>
        <sr-switch isLoading>Loading</sr-switch>
        <sr-switch isLoading="auto" bind:tap="handleAutoLoading">
          Auto Loading
        </sr-switch>
      </view>
    </view>
  </view>
</view>
