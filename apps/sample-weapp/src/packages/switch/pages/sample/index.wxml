<app-page title="Switch" tone="{{tone}}" withBack="{{true}}">
  <view class="{{surfaceClassName}}">
    <view class="{{titleClassName}}">Colors</view>
    <view class="{{descriptionClassName}}">color + controlled</view>
    <view class="mt-3 flex flex-col gap-3">
      <sr-switch
        wx:for="{{colors}}"
        wx:key="value"
        tone="{{tone}}"
        data-value="{{item.value}}"
        color="{{item.value}}"
        isSelected="{{item.value === colorValue}}"
        bind:change="handleColorChange"
      >
        {{item.label}}
      </sr-switch>
    </view>
  </view>

  <view class="{{surfaceClassName}}">
    <view class="{{titleClassName}}">Sizes</view>
    <view class="{{descriptionClassName}}">size + controlled</view>
    <view class="mt-3 flex flex-col gap-3">
      <sr-switch
        wx:for="{{sizes}}"
        wx:key="value"
        tone="{{tone}}"
        data-value="{{item.value}}"
        size="{{item.value}}"
        isSelected="{{item.value === sizeValue}}"
        bind:change="handleSizeChange"
      >
        {{item.label}}
      </sr-switch>
    </view>
  </view>

  <view class="{{surfaceClassName}}">
    <view class="{{titleClassName}}">Custom Icon</view>
    <view class="{{descriptionClassName}}">slot icon</view>
    <view class="mt-3 flex flex-col gap-3">
      <sr-switch tone="{{tone}}" defaultSelected hasIcon>
        <view slot="icon" class="icon-[ion--checkmark] text-primary text-sm" />
        Check
      </sr-switch>
      <sr-switch tone="{{tone}}" defaultSelected hasIcon>
        <view slot="icon" class="icon-[ion--flash] text-warning text-sm" />
        Flash
      </sr-switch>
    </view>
  </view>

  <view class="{{surfaceClassName}}">
    <view class="{{titleClassName}}">States</view>
    <view class="mt-3 flex flex-col gap-3">
      <sr-switch tone="{{tone}}" isSelected="{{isEnabled}}" bind:change="handleEnabledChange">
        Controlled
      </sr-switch>
      <sr-switch tone="{{tone}}" isDisabled>Disabled</sr-switch>
      <sr-switch tone="{{tone}}" isReadOnly defaultSelected>ReadOnly</sr-switch>
      <sr-switch tone="{{tone}}" isLoading>Loading</sr-switch>
      <sr-switch tone="{{tone}}" isLoading="auto" bind:tap="handleAutoLoading">
        Auto Loading
      </sr-switch>
    </view>
  </view>
</app-page>
