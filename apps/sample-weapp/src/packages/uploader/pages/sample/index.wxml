<app-page title="Uploader" description="用于管理文件和图片的选择、上传状态与预览，适合附件上传、头像上传和媒体提交流程。" tone="{{tone}}" withBack="{{true}}">
  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Controlled</view>
    <view class="mt-3">
      <sr-uploader
        value="{{value}}"
        tone="{{tone}}"
        maxCount="{{5}}"
        helperText="{{message}}"
        bind:valuechange="handleValueChange"
        bind:exceed="handleExceed"
      />
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Sizes</view>
    <view class="mt-3 space-y-3">
      <sr-uploader size="sm" tone="{{tone}}" maxCount="{{3}}" addText="Small" />
      <sr-uploader size="md" tone="{{tone}}" maxCount="{{3}}" color="primary" addText="Medium" />
      <sr-uploader size="lg" tone="{{tone}}" maxCount="{{3}}" color="success" addText="Large" />
    </view>
  </view>
</app-page>
