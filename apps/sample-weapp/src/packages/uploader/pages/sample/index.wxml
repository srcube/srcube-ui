<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <sr-navbar
    className="sticky top-0 z-20 border-b border-slate-200"
    title="Uploader"
    withBack="{{true}}"
    hasSafeTop="{{true}}"
  />

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Controlled</view>
      <view class="mt-3">
        <sr-uploader
          value="{{value}}"
          maxCount="{{5}}"
          helperText="{{message}}"
          bind:valuechange="handleValueChange"
          bind:exceed="handleExceed"
        />
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Sizes</view>
      <view class="mt-3 space-y-3">
        <sr-uploader size="sm" maxCount="{{3}}" addText="Small" />
        <sr-uploader size="md" maxCount="{{3}}" color="primary" addText="Medium" />
        <sr-uploader size="lg" maxCount="{{3}}" color="success" addText="Large" />
      </view>
    </view>
  </view>
</view>
