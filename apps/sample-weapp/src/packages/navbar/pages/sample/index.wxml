<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <sr-navbar
    className="sticky top-0 z-20 border-b border-slate-200"
    title="Navbar"
    withBack="{{true}}"
    hasSafeTop="{{true}}"
  />

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Tone</view>
      <view class="mt-3 flex gap-2">
        <sr-button
          size="sm"
          color="{{tone === 'default' ? 'primary' : 'default'}}"
          variant="{{tone === 'default' ? 'solid' : 'flat'}}"
          data-tone="default"
          bind:tap="handleToneTap"
        >
          default
        </sr-button>
        <sr-button
          size="sm"
          tone="dark"
          color="default"
          variant="{{tone === 'dark' ? 'solid' : 'flat'}}"
          data-tone="dark"
          bind:tap="handleToneTap"
        >
          dark
        </sr-button>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Basic</view>
      <sr-navbar
        className="mt-3"
        title="{{title}}"
        titleAlign="{{titleAlign}}"
        tone="{{tone}}"
      />
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Title Align</view>
      <view class="mt-3 flex gap-2">
        <sr-button
          size="sm"
          color="{{titleAlign === 'start' ? 'primary' : 'default'}}"
          variant="{{titleAlign === 'start' ? 'solid' : 'flat'}}"
          data-align="start"
          bind:tap="handleTitleAlignTap"
        >
          start
        </sr-button>
        <sr-button
          size="sm"
          color="{{titleAlign === 'center' ? 'primary' : 'default'}}"
          variant="{{titleAlign === 'center' ? 'solid' : 'flat'}}"
          data-align="center"
          bind:tap="handleTitleAlignTap"
        >
          center
        </sr-button>
        <sr-button
          size="sm"
          color="{{titleAlign === 'end' ? 'primary' : 'default'}}"
          variant="{{titleAlign === 'end' ? 'solid' : 'flat'}}"
          data-align="end"
          bind:tap="handleTitleAlignTap"
        >
          end
        </sr-button>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">With Back</view>
      <sr-navbar
        className="mt-3"
        title="消息"
        withBack
        titleAlign="{{titleAlign}}"
        tone="{{tone}}"
        bind:back="handleBack"
      >
        <view slot="end">
          <view class="inline-flex h-8 w-8 items-center justify-center rounded-full text-slate-700">
            <view class="icon-more text-lg leading-none" />
          </view>
        </view>
      </sr-navbar>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Sizes</view>
      <view class="mt-3 space-y-2">
        <view>
          <sr-navbar size="sm" title="Small" titleAlign="{{titleAlign}}" tone="{{tone}}" />
        </view>
        <view>
          <sr-navbar size="md" title="Medium" titleAlign="{{titleAlign}}" tone="{{tone}}" />
        </view>
        <view>
          <sr-navbar size="lg" title="Large" titleAlign="{{titleAlign}}" tone="{{tone}}" />
        </view>
      </view>
    </view>
  </view>
</view>
