<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <sr-navbar
    className="sticky top-0 z-20 border-b border-slate-200"
    title="Tabs"
    withBack="{{true}}"
    hasSafeTop="{{true}}"
  />

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Basic</view>
      <view class="mt-1 text-xs text-slate-500">horizontal + panel (size=md radius=full)</view>

      <sr-tabs
        className="mt-3"
        items="{{basicTabs}}"
        value="{{basicValue}}"
        size="md"
        radius="full"
        bind:change="handleBasicChange"
      >
        <sr-tab-panel
          value="tab-1"
          activeValue="{{basicValue}}"
          className="rounded-2xl border border-slate-200 bg-white p-4"
        >
          Panel for Tab 1
        </sr-tab-panel>
        <sr-tab-panel
          value="tab-2"
          activeValue="{{basicValue}}"
          className="rounded-2xl border border-slate-200 bg-white p-4"
        >
          Panel for Tab 2
        </sr-tab-panel>
        <sr-tab-panel
          value="tab-3"
          activeValue="{{basicValue}}"
          className="rounded-2xl border border-slate-200 bg-white p-4"
        >
          Panel for Tab 3
        </sr-tab-panel>
      </sr-tabs>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Vertical</view>
      <view class="mt-1 text-xs text-slate-500">
        placement=top/start/end/bottom + variant=underline
      </view>

      <view class="mt-3">
        <sr-button-group size="sm" isBlock>
          <sr-button
            class="flex-1"
            color="{{placementValue === 'top' ? 'primary' : 'default'}}"
            variant="{{placementValue === 'top' ? 'solid' : 'flat'}}"
            data-placement="top"
            bind:tap="handlePlacementTap"
          >
            top
          </sr-button>
          <sr-button
            class="flex-1"
            color="{{placementValue === 'start' ? 'primary' : 'default'}}"
            variant="{{placementValue === 'start' ? 'solid' : 'flat'}}"
            data-placement="start"
            bind:tap="handlePlacementTap"
          >
            start
          </sr-button>
          <sr-button
            class="flex-1"
            color="{{placementValue === 'end' ? 'primary' : 'default'}}"
            variant="{{placementValue === 'end' ? 'solid' : 'flat'}}"
            data-placement="end"
            bind:tap="handlePlacementTap"
          >
            end
          </sr-button>
          <sr-button
            class="flex-1"
            color="{{placementValue === 'bottom' ? 'primary' : 'default'}}"
            variant="{{placementValue === 'bottom' ? 'solid' : 'flat'}}"
            data-placement="bottom"
            bind:tap="handlePlacementTap"
          >
            bottom
          </sr-button>
        </sr-button-group>
      </view>

      <sr-tabs
        className="mt-3 h-44"
        placement="{{placementValue}}"
        items="{{verticalTabs}}"
        value="{{verticalValue}}"
        variant="underline"
        color="primary"
        size="sm"
        radius="none"
        bind:change="handleVerticalChange"
      >
        <sr-tab-panel
          value="tab-a"
          activeValue="{{verticalValue}}"
          className="h-full rounded-2xl border border-slate-200 bg-white p-4 text-sm"
        >
          Panel for Tab A
        </sr-tab-panel>
        <sr-tab-panel
          value="tab-b"
          activeValue="{{verticalValue}}"
          className="h-full rounded-2xl border border-slate-200 bg-white p-4 text-sm"
        >
          Panel for Tab B
        </sr-tab-panel>
        <sr-tab-panel
          value="tab-c"
          activeValue="{{verticalValue}}"
          className="h-full rounded-2xl border border-slate-200 bg-white p-4 text-sm"
        >
          Panel for Tab C (disabled tab)
        </sr-tab-panel>
      </sr-tabs>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Variant / Color</view>
      <view class="mt-1 text-xs text-slate-500">default / outline / twotone / underline</view>

      <view class="mt-3">
        <sr-button-group size="sm" isBlock>
          <sr-button
            class="flex-1"
            color="{{activeVariant === 'default' ? 'primary' : 'default'}}"
            variant="{{activeVariant === 'default' ? 'solid' : 'flat'}}"
            data-variant="default"
            bind:tap="handleVariantTap"
          >
            default
          </sr-button>
          <sr-button
            class="flex-1"
            color="{{activeVariant === 'outline' ? 'primary' : 'default'}}"
            variant="{{activeVariant === 'outline' ? 'solid' : 'flat'}}"
            data-variant="outline"
            bind:tap="handleVariantTap"
          >
            outline
          </sr-button>
          <sr-button
            class="flex-1"
            color="{{activeVariant === 'twotone' ? 'primary' : 'default'}}"
            variant="{{activeVariant === 'twotone' ? 'solid' : 'flat'}}"
            data-variant="twotone"
            bind:tap="handleVariantTap"
          >
            twotone
          </sr-button>
          <sr-button
            class="flex-1"
            color="{{activeVariant === 'underline' ? 'primary' : 'default'}}"
            variant="{{activeVariant === 'underline' ? 'solid' : 'flat'}}"
            data-variant="underline"
            bind:tap="handleVariantTap"
          >
            underline
          </sr-button>
        </sr-button-group>
      </view>

      <view class="mt-2 flex flex-col gap-2">
        <block
          wx:for="{{colorGroups}}"
          wx:for-item="group"
          wx:for-index="groupIndex"
          wx:key="groupIndex"
        >
          <sr-button-group size="sm" isBlock>
            <block wx:for="{{group}}" wx:for-item="option" wx:key="value">
              <sr-button
                class="flex-1"
                color="{{activeColor === option.value ? option.value : 'default'}}"
                variant="{{activeColor === option.value ? 'solid' : 'flat'}}"
                data-color="{{option.value}}"
                bind:tap="handleColorTap"
              >
                {{option.label}}
              </sr-button>
            </block>
          </sr-button-group>
        </block>
      </view>

      <sr-tabs
        className="mt-3"
        items="{{colorTabs}}"
        value="{{colorValue}}"
        color="{{activeColor}}"
        variant="{{activeVariant}}"
        bind:change="handleColorChange"
      />

      <view class="mt-2 text-xs text-slate-500">
        Variant: {{activeVariant}} / Color: {{activeColor}} / Selected: {{colorValue}}
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Tabs Only</view>
      <view class="mt-1 text-xs text-slate-500">
        external custom panel (e.g. swiper / business container)
      </view>

      <sr-tabs
        className="mt-3"
        items="{{customPanelTabs}}"
        value="{{customValue}}"
        size="md"
        radius="md"
        bind:change="handleCustomChange"
      />

      <view class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-600">
        <view wx:if="{{customValue === 'tab-1'}}">External Panel: Tab 1</view>
        <view wx:elif="{{customValue === 'tab-2'}}">External Panel: Tab 2</view>
        <view wx:else>External Panel: Tab 3</view>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Long List</view>
      <view class="mt-1 text-xs text-slate-500">virtualized tabs + edge tap auto shift</view>

      <sr-tabs
        className="mt-3"
        items="{{longTabs}}"
        value="{{longValue}}"
        radius="full"
        estimateSize="{{88}}"
        bind:change="handleLongChange"
      />

      <view class="mt-2 text-xs text-slate-500">
        Selected: {{longValue}}
      </view>
    </view>
  </view>
</view>
