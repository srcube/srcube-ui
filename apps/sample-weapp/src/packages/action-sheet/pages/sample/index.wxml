<app-page title="Action Sheet" tone="{{tone}}" withBack="{{true}}">
  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Basic</view>
    <sr-button className="mt-3" tone="{{tone === 'dark' ? 'dark' : 'light'}}" isBlock="{{true}}" bind:tap="handleOpen">Open Action Sheet</sr-button>
    <view class="mt-2 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">Backdrop press does not close the sheet</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">Result: {{result}}</view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Custom Header</view>
    <sr-button className="mt-3" tone="{{tone === 'dark' ? 'dark' : 'light'}}" variant="flat" isBlock="{{true}}" bind:tap="handleOpenCustom">Open Custom Header</sr-button>
    <view class="mt-2 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">Customize header text with title/description.</view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Custom Footer</view>
    <sr-button className="mt-3" tone="{{tone === 'dark' ? 'dark' : 'light'}}" variant="flat" isBlock="{{true}}" bind:tap="handleOpenFooter">Open Custom Footer</sr-button>
    <view class="mt-2 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">Use hasFooter + slot=footer to replace default cancel button.</view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">cancelButtonProps</view>
    <sr-button className="mt-3" tone="{{tone === 'dark' ? 'dark' : 'light'}}" variant="flat" isBlock="{{true}}" bind:tap="handleOpenCancelProps">Open Custom Cancel Button</sr-button>
    <view class="mt-2 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">Customize cancel button color/variant/className by cancelButtonProps.</view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Size</view>
    <view class="mt-3 flex gap-2">
      <sr-button className="flex-1" tone="{{tone === 'dark' ? 'dark' : 'light'}}" size="sm" variant="flat" bind:tap="handleOpenSizeSm">Small</sr-button>
      <sr-button className="flex-1" tone="{{tone === 'dark' ? 'dark' : 'light'}}" size="md" variant="flat" bind:tap="handleOpenSizeMd">Medium</sr-button>
      <sr-button className="flex-1" tone="{{tone === 'dark' ? 'dark' : 'light'}}" size="lg" variant="flat" bind:tap="handleOpenSizeLg">Large</sr-button>
    </view>
  </view>

  <sr-action-sheet isOpen="{{isOpen}}" tone="{{tone}}" title="More Actions" description="Choose an action" actions="{{actions}}" isInset="{{true}}" bind:action="handleAction" bind:change="handleChange" />
  <sr-action-sheet isOpen="{{customOpen}}" tone="{{tone}}" title="🔔 Notification Shortcuts" description="This is a custom header example" actions="{{actions}}" isInset="{{true}}" bind:action="handleAction" bind:change="handleCustomChange" />
  <sr-action-sheet isOpen="{{footerOpen}}" tone="{{tone}}" title="Export Report" description="Use custom footer with your own layout" actions="{{actions}}" hasFooter="{{true}}" isInset="{{true}}" bind:action="handleAction" bind:change="handleFooterChange">
    <view slot="footer">
      <sr-button-group className="w-full" tone="{{tone === 'dark' ? 'dark' : 'light'}}" color="default" variant="flat" radius="lg" size="md" isBlock="{{true}}">
        <sr-button class="flex-1" bind:tap="handleFooterLater">Later</sr-button>
        <sr-button class="flex-1" color="danger" bind:tap="handleFooterDismiss">Dismiss</sr-button>
      </sr-button-group>
    </view>
  </sr-action-sheet>
  <sr-action-sheet isOpen="{{cancelPropsOpen}}" tone="{{tone}}" title="Unsaved Changes" description="Cancel button is customized by cancelButtonProps" actions="{{actions}}" cancelText="Discard" cancelButtonProps="{{cancelButtonProps}}" isInset="{{true}}" bind:action="handleAction" bind:change="handleCancelPropsChange" />
  <sr-action-sheet isOpen="{{sizeSmOpen}}" tone="{{tone}}" size="sm" title="Small Size" description="Action sheet with size=sm" actions="{{actions}}" isInset="{{true}}" bind:action="handleAction" bind:change="handleSizeSmChange" />
  <sr-action-sheet isOpen="{{sizeMdOpen}}" tone="{{tone}}" size="md" title="Medium Size" description="Action sheet with size=md (default)" actions="{{actions}}" isInset="{{true}}" bind:action="handleAction" bind:change="handleSizeMdChange" />
  <sr-action-sheet isOpen="{{sizeLgOpen}}" tone="{{tone}}" size="lg" title="Large Size" description="Action sheet with size=lg" actions="{{actions}}" isInset="{{true}}" bind:action="handleAction" bind:change="handleSizeLgChange" />
</app-page>
