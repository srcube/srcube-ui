<app-page title="Pickbox" tone="{{tone}}" withBack="{{true}}">
  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Multi Column Picker</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">多列虚拟列表 + 中心指示器 + 滚动结束自动对齐</view>

    <sr-pickbox
      className="mt-3 h-72 rounded-2xl border {{tone === 'dark' ? 'border-zinc-800' : 'border-slate-200'}}"
      columns="{{columns}}"
      value="{{value}}"
      tone="{{tone}}"
      estimateSize="44"
      overscan="8"
      indicatorHeight="44"
      bind:valuechange="handleValueChange"
    />

    <view class="mt-3 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">Selected: {{valueText}}</view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Colors</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">使用 2 组 sm ButtonGroup 切换颜色（default=100，语义色=50）</view>

    <view class="mt-3 flex flex-col gap-2">
      <block wx:for="{{colorGroups}}" wx:for-item="group" wx:for-index="groupIndex" wx:key="groupIndex">
        <sr-button-group className="w-full" tone="{{tone === 'dark' ? 'dark' : 'light'}}" size="sm" variant="outline" isBlock>
          <block wx:for="{{group}}" wx:for-item="option" wx:key="value">
            <sr-button
              class="flex-1"
              color="{{activeColor === option.value ? option.value : 'default'}}"
              variant="{{activeColor === option.value ? 'solid' : 'flat'}}"
              data-color="{{option.value}}"
              bind:tap="handleColorTap"
            >
              {{option.label}}
            </sr-button>
          </block>
        </sr-button-group>
      </block>
    </view>

    <sr-pickbox
      className="mt-3 h-52 rounded-2xl border {{tone === 'dark' ? 'border-zinc-800' : 'border-slate-200'}}"
      color="{{activeColor}}"
      tone="{{tone}}"
      columns="{{columns}}"
      value="{{colorValue}}"
      estimateSize="44"
      overscan="8"
      indicatorHeight="44"
      bind:valuechange="handleColorValueChange"
    />

    <view class="mt-2 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">Color: {{activeColor}} / Selected: {{colorValueText}}</view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Sizes</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">sm / md / lg 高度由 size 决定（不额外覆盖 height）</view>

    <view class="mt-3 flex flex-col gap-4">
      <view>
        <view class="mb-2 text-xs font-medium {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">size = sm</view>
        <sr-pickbox className="rounded-2xl border {{tone === 'dark' ? 'border-zinc-800' : 'border-slate-200'}}" tone="{{tone}}" size="sm" columns="{{columns}}" defaultValue="{{sizeValue}}" overscan="8" />
      </view>
      <view>
        <view class="mb-2 text-xs font-medium {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">size = md</view>
        <sr-pickbox className="rounded-2xl border {{tone === 'dark' ? 'border-zinc-800' : 'border-slate-200'}}" tone="{{tone}}" size="md" columns="{{columns}}" defaultValue="{{sizeValue}}" overscan="8" />
      </view>
      <view>
        <view class="mb-2 text-xs font-medium {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">size = lg</view>
        <sr-pickbox className="rounded-2xl border {{tone === 'dark' ? 'border-zinc-800' : 'border-slate-200'}}" tone="{{tone}}" size="lg" columns="{{columns}}" defaultValue="{{sizeValue}}" overscan="8" />
      </view>
    </view>
  </view>
</app-page>
