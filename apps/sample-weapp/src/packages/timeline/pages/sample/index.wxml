<app-page title="Timeline" tone="{{tone}}" withBack="{{true}}">
  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Default</view>
    <view class="mt-3">
      <sr-timeline items="{{productTimeline}}" tone="{{tone}}" />
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Dashed / Small</view>
    <view class="mt-3">
      <sr-timeline items="{{dashedTimeline}}" tone="{{tone}}" size="sm" line-style="dashed" />
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Custom Icons</view>
    <view class="mt-3">
      <sr-timeline items="{{customIconTimeline}}" tone="{{tone}}" />
    </view>
  </view>
</app-page>
