<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <sr-navbar
    className="sticky top-0 z-20 border-b border-slate-200"
    title="Tour"
    withBack="{{true}}"
    hasSafeTop="{{true}}"
  />

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Controls</view>
      <view class="mt-1 text-xs text-slate-500">open tour / open from step / tone</view>

      <view class="mt-3 flex flex-wrap gap-2">
        <sr-button bind:tap="handleStartTap">Start Tour</sr-button>
        <sr-button variant="outline" bind:tap="handleStartFromThirdTap">
          Start from Step 3
        </sr-button>
      </view>

      <view class="mt-3">
        <sr-button-group size="sm" isBlock>
          <sr-button
            class="flex-1"
            color="{{tone === 'default' ? 'primary' : 'default'}}"
            variant="{{tone === 'default' ? 'solid' : 'flat'}}"
            data-tone="default"
            bind:tap="handleToneTap"
          >
            default
          </sr-button>
          <sr-button
            class="flex-1"
            color="{{tone === 'dark' ? 'primary' : 'default'}}"
            variant="{{tone === 'dark' ? 'solid' : 'flat'}}"
            data-tone="dark"
            bind:tap="handleToneTap"
          >
            dark
          </sr-button>
        </sr-button-group>
      </view>

      <view class="mt-2 text-xs text-slate-500">
        Step: {{currentStep + 1}} / {{steps.length}} · Event: {{lastEvent}}
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Targets</view>
      <view class="mt-1 text-xs text-slate-500">
        scroll down to test auto scroll to bottom target
      </view>

      <view class="mt-3 space-y-3">
        <view
          id="tour-target-search"
          class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm"
        >
          Search Input Area
        </view>
        <view
          id="tour-target-filter"
          class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm"
        >
          Filter Group Area
        </view>
        <view
          id="tour-target-list"
          class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm"
        >
          List Container Header
        </view>
      </view>

      <view class="mt-4 h-[520px] rounded-xl border border-dashed border-slate-300 bg-slate-50 p-3 text-xs text-slate-500">
        Placeholder content to create scroll distance.
      </view>

      <view
        id="tour-target-submit"
        class="mt-4 rounded-xl bg-primary px-3 py-2 text-sm text-white"
      >
        Submit Button Area
      </view>
    </view>
  </view>

  <sr-tour
    isOpen="{{isOpen}}"
    currentStep="{{currentStep}}"
    steps="{{steps}}"
    tone="{{tone}}"
    canMaskClose
    canBackdropClose="{{false}}"
    bind:openchange="handleOpenChange"
    bind:stepchange="handleStepChange"
    bind:skip="handleSkip"
    bind:finish="handleFinish"
  />
</view>
