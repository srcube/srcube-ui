<app-page title="Tour" description="用于通过锚点指引一步步介绍产品功能，适合新手引导、功能教学和功能发现。" tone="{{tone}}" withBack="{{true}}">
  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Controls</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">open tour / open from step</view>

    <view class="mt-3 flex flex-wrap gap-2">
      <sr-button tone="{{tone === 'dark' ? 'dark' : 'light'}}" bind:tap="handleStartTap">Start Tour</sr-button>
      <sr-button
        tone="{{tone === 'dark' ? 'dark' : 'light'}}"
        variant="outline"
        bind:tap="handleStartFromThirdTap"
      >
        Start from Step 3
      </sr-button>
    </view>

    <view class="mt-2 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
      Step: {{currentStep + 1}} / {{steps.length}} · Event: {{lastEvent}}
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Targets</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
      scroll down to test auto scroll to bottom target
    </view>

    <view class="mt-3 space-y-3">
      <view
        id="tour-target-search"
        class="rounded-xl border px-3 py-2 text-sm {{tone === 'dark' ? 'border-zinc-700 bg-zinc-950' : 'border-slate-200 bg-white'}}"
      >
        Search Input Area
      </view>
      <view
        id="tour-target-filter"
        class="rounded-xl border px-3 py-2 text-sm {{tone === 'dark' ? 'border-zinc-700 bg-zinc-950' : 'border-slate-200 bg-white'}}"
      >
        Filter Group Area
      </view>
      <view
        id="tour-target-list"
        class="rounded-xl border px-3 py-2 text-sm {{tone === 'dark' ? 'border-zinc-700 bg-zinc-950' : 'border-slate-200 bg-white'}}"
      >
        List Container Header
      </view>
    </view>

    <view class="mt-4 h-[520px] rounded-xl border border-dashed p-3 text-xs {{tone === 'dark' ? 'border-zinc-700 bg-zinc-950 text-zinc-400' : 'border-slate-300 bg-slate-50 text-slate-500'}}">
      Placeholder content to create scroll distance.
    </view>

    <view
      id="tour-target-submit"
      class="mt-4 rounded-xl bg-primary px-3 py-2 text-sm text-white"
    >
      Submit Button Area
    </view>
  </view>

  <sr-tour
    isOpen="{{isOpen}}"
    currentStep="{{currentStep}}"
    steps="{{steps}}"
    tone="{{tone}}"
    canMaskClose
    canBackdropClose="{{false}}"
    bind:openchange="handleOpenChange"
    bind:stepchange="handleStepChange"
    bind:skip="handleSkip"
    bind:finish="handleFinish"
  />
</app-page>
