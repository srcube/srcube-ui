<app-page title="Menu" description="用于在结构化弹出列表中展示上下文操作和导航选项，适合命令菜单、溢出操作和紧凑导航。" tone="{{tone}}" withBack="{{true}}">
  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Basic (Controlled)</view>
    <view class="mt-3">
      <sr-menu
        items="{{menuItems}}"
        value="{{controlledValue}}"
        isOpen="{{controlledOpen}}"
        tone="{{tone}}"
        bind:change="handleOpenChange"
        bind:select="handleSelect"
        color="primary"
        variant="flat"
      >
        <button slot="trigger">更多操作</button>
      </sr-menu>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Orientation</view>
    <view class="mt-3">
      <sr-menu items="{{horizontalItems}}" tone="{{tone}}" orientation="x" defaultValue="all" hasArrow="{{false}}">
        <button slot="trigger">横向菜单</button>
      </sr-menu>
    </view>
    <view class="mt-3">
      <sr-menu items="{{menuItems}}" tone="{{tone}}" orientation="y" defaultValue="edit" color="secondary">
        <button slot="trigger">纵向菜单</button>
      </sr-menu>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Size & Radius</view>
    <view class="mt-3 flex flex-wrap gap-3">
      <sr-menu items="{{menuItems}}" tone="{{tone}}" size="sm" radius="sm" hasArrow="{{false}}">
        <button slot="trigger">SM</button>
      </sr-menu>
      <sr-menu items="{{menuItems}}" tone="{{tone}}" size="md" radius="md" hasArrow="{{false}}">
        <button slot="trigger">MD</button>
      </sr-menu>
      <sr-menu items="{{menuItems}}" tone="{{tone}}" size="lg" radius="full" hasArrow="{{false}}">
        <button slot="trigger">LG</button>
      </sr-menu>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Tone + Variant + Color</view>
    <view class="mt-3 flex flex-wrap gap-3">
      <sr-menu items="{{menuItems}}" defaultValue="share" color="success" variant="solid" tone="{{tone}}">
        <button slot="trigger">Follow Theme</button>
      </sr-menu>
      <sr-menu items="{{darkItems}}" defaultValue="high" color="warning" variant="flat" tone="dark">
        <button slot="trigger">Dark Preview</button>
      </sr-menu>
    </view>
  </view>
</app-page>
