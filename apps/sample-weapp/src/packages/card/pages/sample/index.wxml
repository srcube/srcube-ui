<app-page title="Card" description="用于在清晰的容器中组织相关内容和操作，适合仪表盘、摘要信息和模块化内容块。" tone="{{tone}}" withBack="{{true}}">
  <view>
    <sr-card hasHeader="{{true}}" hasFooter="{{true}}" tone="{{tone}}">
      <view slot="header">订单信息</view>
      <view slot="body" class="space-y-2 text-sm">
        <view>订单号：A20260218001</view>
        <view>收货人：Srcube</view>
        <view>金额：¥ 168.00</view>
      </view>
      <view slot="footer" class="flex gap-2">
        <sr-button size="sm" variant="flat" color="default" tone="{{tone === 'dark' ? 'dark' : 'light'}}">取消</sr-button>
        <sr-button size="sm" color="primary" tone="{{tone === 'dark' ? 'dark' : 'light'}}">确认</sr-button>
      </view>
    </sr-card>
  </view>

  <view class="space-y-3">
    <view>
      <sr-card hasHeader="{{true}}" tone="{{tone}}">
        <view slot="header">Color: default</view>
        <view slot="body">默认样式</view>
      </sr-card>
    </view>
    <view>
      <sr-card color="primary" tone="{{tone}}" hasHeader="{{true}}">
        <view slot="header">Color: primary</view>
        <view slot="body">主色样式</view>
      </sr-card>
    </view>
    <view>
      <sr-card color="success" tone="{{tone}}" hasHeader="{{true}}">
        <view slot="header">Color: success</view>
        <view slot="body">成功色样式</view>
      </sr-card>
    </view>
    <view>
      <sr-card color="warning" tone="{{tone}}" hasHeader="{{true}}">
        <view slot="header">Color: warning</view>
        <view slot="body">警告色样式</view>
      </sr-card>
    </view>
  </view>

  <view class="space-y-3">
    <view>
      <sr-card size="sm" radius="sm" tone="{{tone}}" hasHeader="{{true}}">
        <view slot="header">Small</view>
        <view slot="body">size=sm / radius=sm</view>
      </sr-card>
    </view>
    <view>
      <sr-card size="md" radius="md" color="secondary" tone="{{tone}}" hasHeader="{{true}}">
        <view slot="header">Medium</view>
        <view slot="body">size=md / radius=md</view>
      </sr-card>
    </view>
    <view>
      <sr-card size="lg" radius="lg" color="danger" tone="{{tone}}" hasHeader="{{true}}">
        <view slot="header">Large</view>
        <view slot="body">size=lg / radius=lg</view>
      </sr-card>
    </view>
  </view>

  <view>
    <sr-card hasHeader="{{true}}" tone="{{tone}}">
      <view slot="header">应用里的示例卡片容器</view>
      <view slot="body" class="space-y-3 text-sm">
        <view class="font-medium {{tone === 'dark' ? 'text-zinc-100' : 'text-slate-900'}}">本周发布进度</view>
        <view class="rounded-xl px-3 py-2 {{tone === 'dark' ? 'bg-zinc-800 text-zinc-300' : 'bg-slate-100 text-slate-600'}}">已完成组件联调与样式回归，等待 QA 最终确认。</view>
        <view class="flex items-center justify-between text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
          <text>发布窗口</text>
          <text>今天 20:30</text>
        </view>
      </view>
    </sr-card>
  </view>
</app-page>
