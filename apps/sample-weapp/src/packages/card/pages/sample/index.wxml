<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <sr-navbar
    className="sticky top-0 z-20 border-b border-slate-200"
    title="Card"
    withBack="{{true}}"
    hasSafeTop="{{true}}"
  />

  <view class="p-4 space-y-6">
    <view>
      <sr-card hasHeader="{{true}}" hasFooter="{{true}}">
        <view slot="header">订单信息</view>
        <view slot="body" class="space-y-2 text-sm">
          <view>订单号：A20260218001</view>
          <view>收货人：Srcube</view>
          <view>金额：¥ 168.00</view>
        </view>
        <view slot="footer" class="flex gap-2">
          <sr-button size="sm" variant="flat" color="default">取消</sr-button>
          <sr-button size="sm" color="primary">确认</sr-button>
        </view>
      </sr-card>
    </view>

    <view class="space-y-3">
      <view>
        <sr-card hasHeader="{{true}}">
          <view slot="header">Color: default</view>
          <view slot="body">默认样式</view>
        </sr-card>
      </view>
      <view>
        <sr-card color="primary" hasHeader="{{true}}">
          <view slot="header">Color: primary</view>
          <view slot="body">主色样式</view>
        </sr-card>
      </view>
      <view>
        <sr-card color="success" hasHeader="{{true}}">
          <view slot="header">Color: success</view>
          <view slot="body">成功色样式</view>
        </sr-card>
      </view>
      <view>
        <sr-card color="warning" hasHeader="{{true}}">
          <view slot="header">Color: warning</view>
          <view slot="body">警告色样式</view>
        </sr-card>
      </view>
    </view>

    <view class="space-y-3">
      <view>
        <sr-card size="sm" radius="sm" hasHeader="{{true}}">
          <view slot="header">Small</view>
          <view slot="body">size=sm / radius=sm</view>
        </sr-card>
      </view>
      <view>
        <sr-card size="md" radius="md" color="secondary" hasHeader="{{true}}">
          <view slot="header">Medium</view>
          <view slot="body">size=md / radius=md</view>
        </sr-card>
      </view>
      <view>
        <sr-card size="lg" radius="lg" color="danger" hasHeader="{{true}}">
          <view slot="header">Large</view>
          <view slot="body">size=lg / radius=lg</view>
        </sr-card>
      </view>
    </view>
  </view>
</view>
