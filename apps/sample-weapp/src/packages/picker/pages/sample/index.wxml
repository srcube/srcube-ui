<app-page title="Picker" description="用于从预设数据中选择值，比如日期、时间和选项。适合约束明确的选择流程。" tone="{{tone}}" withBack="{{true}}">
  <view class="p-4 space-y-6">
    <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
      <view class="text-sm font-semibold">Datetime Mode</view>
      <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">datetime / date / time</view>

      <view class="mt-3">
        <sr-button-group size="sm" tone="{{tone === 'dark' ? 'dark' : 'light'}}" isBlock>
          <sr-button
            class="flex-1"
            tone="{{tone === 'dark' ? 'dark' : 'light'}}"
            color="{{datetimeMode === 'datetime' ? 'primary' : 'default'}}"
            variant="{{datetimeMode === 'datetime' ? 'solid' : 'flat'}}"
            data-mode="datetime"
            bind:tap="handleDatetimeModeTap"
          >
            datetime
          </sr-button>
          <sr-button
            class="flex-1"
            tone="{{tone === 'dark' ? 'dark' : 'light'}}"
            color="{{datetimeMode === 'date' ? 'primary' : 'default'}}"
            variant="{{datetimeMode === 'date' ? 'solid' : 'flat'}}"
            data-mode="date"
            bind:tap="handleDatetimeModeTap"
          >
            date
          </sr-button>
          <sr-button
            class="flex-1"
            tone="{{tone === 'dark' ? 'dark' : 'light'}}"
            color="{{datetimeMode === 'time' ? 'primary' : 'default'}}"
            variant="{{datetimeMode === 'time' ? 'solid' : 'flat'}}"
            data-mode="time"
            bind:tap="handleDatetimeModeTap"
          >
            time
          </sr-button>
        </sr-button-group>
      </view>
    </view>

    <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
      <view class="text-sm font-semibold">Size</view>
      <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
        同步到 Drawer title、Pickbox/Selectbox 与 footer button
      </view>

      <view class="mt-3">
        <sr-button-group size="sm" tone="{{tone === 'dark' ? 'dark' : 'light'}}" isBlock>
          <sr-button
            class="flex-1"
            tone="{{tone === 'dark' ? 'dark' : 'light'}}"
            color="{{pickerSize === 'sm' ? 'primary' : 'default'}}"
            variant="{{pickerSize === 'sm' ? 'solid' : 'flat'}}"
            data-size="sm"
            bind:tap="handleSizeTap"
          >
            sm
          </sr-button>
          <sr-button
            class="flex-1"
            tone="{{tone === 'dark' ? 'dark' : 'light'}}"
            color="{{pickerSize === 'md' ? 'primary' : 'default'}}"
            variant="{{pickerSize === 'md' ? 'solid' : 'flat'}}"
            data-size="md"
            bind:tap="handleSizeTap"
          >
            md
          </sr-button>
          <sr-button
            class="flex-1"
            tone="{{tone === 'dark' ? 'dark' : 'light'}}"
            color="{{pickerSize === 'lg' ? 'primary' : 'default'}}"
            variant="{{pickerSize === 'lg' ? 'solid' : 'flat'}}"
            data-size="lg"
            bind:tap="handleSizeTap"
          >
            lg
          </sr-button>
        </sr-button-group>
      </view>
    </view>

    <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
      <view class="text-sm font-semibold">Single</view>
      <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
        Field + Drawer(bottom) + Pickbox，dismiss=取消
      </view>

      <sr-picker
        className="mt-3"
        label="城市"
        tone="{{tone}}"
        size="{{pickerSize}}"
        color="primary"
        items="{{singleItems}}"
        value="{{singleValue}}"
        bind:valuechange="handleSingleValueChange"
      />

      <view class="mt-2 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
        Value: {{singleValue[0] || 'none'}}
      </view>
    </view>

    <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
      <view class="text-sm font-semibold">Clearable</view>
      <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
        基础 Picker 支持 isClearable，选中后可一键清空
      </view>

      <sr-picker
        className="mt-3"
        label="可清空城市"
        tone="{{tone}}"
        size="{{pickerSize}}"
        color="primary"
        items="{{singleItems}}"
        value="{{clearableValue}}"
        isClearable="{{true}}"
        bind:valuechange="handleClearableValueChange"
      />

      <view class="mt-2 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
        Value: {{clearableValue[0] || 'none'}}
      </view>
    </view>

    <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
      <view class="text-sm font-semibold">Cascader Columns</view>
      <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
        使用 options 构建级联多列（替代原 multiple 示例）
      </view>

      <sr-picker
        className="mt-3"
        label="商品偏好"
        color="secondary"
        tone="{{tone}}"
        size="{{pickerSize}}"
        options="{{cascadeOptions}}"
        value="{{cascadeValue}}"
        bind:valuechange="handleCascadeValueChange"
      />

      <view class="mt-2 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
        Value: {{cascadeValueText}}
      </view>
    </view>

    <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
      <view class="text-sm font-semibold">PickerSelect</view>
      <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
        多选场景使用 PickerSelect（内部为 Selectbox）
      </view>

      <sr-picker-select
        className="mt-3"
        label="里程碑"
        color="primary"
        tone="{{tone}}"
        size="{{pickerSize}}"
        items="{{selectItems}}"
        value="{{selectValue}}"
        selectionMode="multiple"
        bind:valuechange="handleSelectValueChange"
      />

      <view class="mt-2 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
        Value: {{selectValueText}}
      </view>
    </view>

    <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
      <view class="text-sm font-semibold">PickerDatetime</view>
      <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
        mode + format；mode=datetime 时展示全宽 Date/Time Tab
      </view>

      <sr-picker-datetime
        className="mt-3"
        label="日期时间"
        color="success"
        tone="{{tone}}"
        size="{{pickerSize}}"
        mode="{{datetimeMode}}"
        format="{{datetimeFormat}}"
        value="{{datetimeValue}}"
        bind:valuechange="handleDatetimeValueChange"
      />

      <view class="mt-2 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
        Value: {{datetimeValue || 'none'}}
      </view>
    </view>

    <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
      <view class="text-sm font-semibold">PickerDatetimeRange</view>
      <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
        start/end + date/time 双层全宽 Tab，支持 format
      </view>

      <sr-picker-datetime-range
        className="mt-3"
        label="日期时间区间"
        color="primary"
        tone="{{tone}}"
        size="{{pickerSize}}"
        mode="{{datetimeMode}}"
        format="{{datetimeFormat}}"
        value="{{datetimeRangeValue}}"
        bind:valuechange="handleDatetimeRangeValueChange"
      />

      <view class="mt-2 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
        Value: {{datetimeRangeValue.start || '--'}} ~ {{datetimeRangeValue.end || '--'}}
      </view>
    </view>

    <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
      <view class="text-sm font-semibold">Default Value</view>
      <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
        单独展示 defaultValue；其它示例均从空值开始
      </view>

      <view class="mt-3 space-y-4">
        <sr-picker
          label="默认城市"
          color="primary"
          tone="{{tone}}"
          size="{{pickerSize}}"
          items="{{singleItems}}"
          defaultValue="{{defaultSingleValue}}"
        />

        <sr-picker
          label="默认商品偏好"
          color="secondary"
          tone="{{tone}}"
          size="{{pickerSize}}"
          options="{{cascadeOptions}}"
          defaultValue="{{defaultCascadeValue}}"
        />

        <sr-picker-select
          label="默认里程碑"
          color="primary"
          tone="{{tone}}"
          size="{{pickerSize}}"
          items="{{selectItems}}"
          selectionMode="multiple"
          defaultValue="{{defaultSelectValue}}"
        />

        <sr-picker-datetime
          label="默认日期时间"
          color="success"
          tone="{{tone}}"
          size="{{pickerSize}}"
          mode="{{datetimeMode}}"
          format="{{datetimeFormat}}"
          defaultValue="{{defaultDatetimeValue}}"
        />

        <sr-picker-datetime-range
          label="默认日期时间区间"
          color="primary"
          tone="{{tone}}"
          size="{{pickerSize}}"
          mode="{{datetimeMode}}"
          format="{{datetimeFormat}}"
          defaultValue="{{defaultDatetimeRangeValue}}"
        />
      </view>
    </view>
  </view>
</app-page>
