<app-page title="Steps" description="用于展示多阶段流程的当前进度和状态，适合引导流程、下单流程和多步骤任务。" tone="{{tone}}" withBack="{{true}}">
  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Size</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">global size control</view>
    <view class="mt-3">
      <sr-button-group size="sm" isBlock>
        <sr-button
          wx:for="{{sizeOptions}}"
          wx:key="value"
          class="flex-1"
          color="{{globalSize === item.value ? 'primary' : 'default'}}"
          variant="{{globalSize === item.value ? 'solid' : 'flat'}}"
          tone="{{tone === 'dark' ? 'dark' : 'light'}}"
          data-size="{{item.value}}"
          bind:tap="handleGlobalSizeTap"
        >
          {{item.label}}
        </sr-button>
      </sr-button-group>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Variant</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">global variant control</view>
    <view class="mt-3 flex flex-col gap-2">
      <sr-button-group size="sm" isBlock>
        <sr-button
          wx:for="{{variantOptionsFirst}}"
          wx:key="value"
          class="flex-1"
          color="{{globalVariant === item.value ? 'primary' : 'default'}}"
          variant="{{globalVariant === item.value ? 'solid' : 'flat'}}"
          tone="{{tone === 'dark' ? 'dark' : 'light'}}"
          data-variant="{{item.value}}"
          bind:tap="handleGlobalVariantTap"
        >
          {{item.label}}
        </sr-button>
      </sr-button-group>
      <sr-button-group size="sm" isBlock>
        <sr-button
          wx:for="{{variantOptionsSecond}}"
          wx:key="value"
          class="flex-1"
          color="{{globalVariant === item.value ? 'primary' : 'default'}}"
          variant="{{globalVariant === item.value ? 'solid' : 'flat'}}"
          tone="{{tone === 'dark' ? 'dark' : 'light'}}"
          data-variant="{{item.value}}"
          bind:tap="handleGlobalVariantTap"
        >
          {{item.label}}
        </sr-button>
      </sr-button-group>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Color</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">global color control</view>
    <view class="mt-3 flex flex-col gap-2">
      <block
        wx:for="{{stepColorGroups}}"
        wx:for-item="group"
        wx:for-index="groupIndex"
        wx:key="groupIndex"
      >
        <sr-button-group size="sm" isBlock>
          <block wx:for="{{group}}" wx:for-item="option" wx:key="value">
            <sr-button
              class="flex-1"
              color="{{globalColor === option.value ? option.value : 'default'}}"
              variant="{{globalColor === option.value ? 'solid' : 'flat'}}"
              tone="{{tone === 'dark' ? 'dark' : 'light'}}"
              data-color="{{option.value}}"
              bind:tap="handleGlobalColorTap"
            >
              {{option.label}}
            </sr-button>
          </block>
        </sr-button-group>
      </block>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Horizontal</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">uses global size / variant / color</view>
    <view class="mt-3">
      <sr-steps
        items="{{checkoutSteps}}"
        current="{{1}}"
        size="{{globalSize}}"
        color="{{globalColor}}"
        tone="{{tone}}"
        variant="{{globalVariant}}"
      />
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Vertical</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">uses global size / variant / color</view>
    <view class="mt-3">
      <sr-steps
        items="{{checkoutSteps}}"
        current="{{1}}"
        orientation="y"
        size="{{globalSize}}"
        color="{{globalColor}}"
        tone="{{tone}}"
        variant="{{globalVariant}}"
      />
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Vertical Dot</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">uses global size / color</view>
    <view class="mt-3">
      <sr-steps
        items="{{checkoutSteps}}"
        current="{{2}}"
        orientation="y"
        size="{{globalSize}}"
        color="{{globalColor}}"
        tone="{{tone}}"
        variant="{{globalVariant}}"
        is-dot="{{true}}"
      />
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Vertical No Description</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">items without description</view>
    <view class="mt-3">
      <sr-steps
        items="{{noDescriptionSteps}}"
        current="{{1}}"
        orientation="y"
        size="{{globalSize}}"
        color="{{globalColor}}"
        tone="{{tone}}"
        variant="{{globalVariant}}"
      />
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Custom Status</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">with finish / error status</view>
    <view class="mt-3">
      <sr-steps
        items="{{issueSteps}}"
        orientation="y"
        size="{{globalSize}}"
        color="{{globalColor}}"
        tone="{{tone}}"
        variant="{{globalVariant}}"
      />
    </view>
  </view>
</app-page>
