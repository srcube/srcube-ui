<app-page title="Avatar" tone="{{tone}}" withBack="{{true}}">
  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Basic</view>
    <view class="mt-3 flex items-center gap-3">
      <sr-avatar name="Srcube User" tone="{{tone}}" />
      <sr-avatar name="Taylor Swift" color="primary" tone="{{tone}}" />
      <sr-avatar icon="?" color="warning" tone="{{tone}}" />
      <sr-avatar src="/sample-avatar.png" fallback="FB" color="danger" tone="{{tone}}" />
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Image / Sizes</view>
    <view class="mt-3 flex items-end gap-3">
      <sr-avatar size="sm" src="{{avatarUrl}}" tone="{{tone}}" />
      <sr-avatar size="md" src="{{avatarUrl}}" tone="{{tone}}" />
      <sr-avatar size="lg" src="{{avatarUrl}}" tone="{{tone}}" />
      <sr-avatar size="xl" src="{{avatarUrl}}" tone="{{tone}}" isBordered="{{true}}" />
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Radius</view>
    <view class="mt-3 flex items-center gap-3">
      <sr-avatar radius="none" name="RN" tone="{{tone}}" />
      <sr-avatar radius="sm" name="RS" tone="{{tone}}" />
      <sr-avatar radius="md" name="RM" tone="{{tone}}" />
      <sr-avatar radius="lg" name="RL" tone="{{tone}}" />
      <sr-avatar radius="full" name="RF" tone="{{tone}}" />
    </view>
  </view>
</app-page>
