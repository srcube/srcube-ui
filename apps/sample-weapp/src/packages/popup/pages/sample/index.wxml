<app-page title="Popup" description="用于在当前页面上方展示分层内容，适合确认操作、快捷操作和轻量详情展示。" tone="{{tone}}" withBack="{{true}}">
  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Basic</view>
    <view class="mt-3 flex flex-wrap gap-3">
      <sr-button tone="{{tone === 'dark' ? 'dark' : 'light'}}" bind:tap="openBasic">Open Popup</sr-button>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Backdrop</view>
    <view class="mt-3 flex flex-wrap gap-2">
      <sr-button tone="{{tone === 'dark' ? 'dark' : 'light'}}" data-backdrop="opaque" variant="outline" bind:tap="openBackdrop">Opaque</sr-button>
      <sr-button tone="{{tone === 'dark' ? 'dark' : 'light'}}" data-backdrop="blur" variant="outline" bind:tap="openBackdrop">Blur</sr-button>
      <sr-button tone="{{tone === 'dark' ? 'dark' : 'light'}}" data-backdrop="transparent" variant="outline" bind:tap="openBackdrop">Transparent</sr-button>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Non Dismissable</view>
    <view class="mt-3 flex flex-wrap gap-3">
      <sr-button tone="{{tone === 'dark' ? 'dark' : 'light'}}" bind:tap="openLocked">Open Locked</sr-button>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">No Backdrop</view>
    <view class="mt-3 flex flex-wrap gap-3">
      <sr-button tone="{{tone === 'dark' ? 'dark' : 'light'}}" bind:tap="openNoBackdrop">Open Popup</sr-button>
    </view>
  </view>

  <sr-popup isOpen="{{basicOpen}}" tone="{{tone}}" bind:openchange="handleBasicChange">
    <view slot="header">Basic Popup</view>
    <view slot="body" class="min-h-24">This is a basic popup message.</view>
    <view slot="footer" class="flex items-center justify-end gap-2">
      <sr-button tone="{{tone === 'dark' ? 'dark' : 'light'}}" variant="text" bind:tap="closeBasic">Cancel</sr-button>
      <sr-button tone="{{tone === 'dark' ? 'dark' : 'light'}}" bind:tap="closeBasic">Confirm</sr-button>
    </view>
  </sr-popup>

  <sr-popup isOpen="{{backdropOpen}}" tone="{{tone}}" backdrop="{{backdropValue}}" bind:openchange="handleBackdropChange">
    <view slot="header">Backdrop: {{backdropValue}}</view>
    <view slot="body" class="min-h-24">Switch between backdrop styles.</view>
    <view slot="footer" class="flex items-center justify-end gap-2">
      <sr-button tone="{{tone === 'dark' ? 'dark' : 'light'}}" variant="text" bind:tap="closeBackdrop">Close</sr-button>
    </view>
  </sr-popup>

  <sr-popup isOpen="{{lockedOpen}}" tone="{{tone}}" isDismissable="{{false}}" bind:openchange="handleLockedChange">
    <view slot="header">Locked Popup</view>
    <view slot="body" class="min-h-24">Backdrop clicks are disabled. Use the button to close.</view>
    <view slot="footer" class="flex items-center justify-end gap-2">
      <sr-button tone="{{tone === 'dark' ? 'dark' : 'light'}}" variant="text" bind:tap="closeLocked">Close</sr-button>
    </view>
  </sr-popup>

  <sr-popup isOpen="{{noBackdropOpen}}" tone="{{tone}}" hasBackdrop="{{false}}" bind:openchange="handleNoBackdropChange">
    <view slot="header">No Backdrop</view>
    <view slot="body" class="min-h-24">Popup without a backdrop.</view>
    <view slot="footer" class="flex items-center justify-end gap-2">
      <sr-button tone="{{tone === 'dark' ? 'dark' : 'light'}}" variant="text" bind:tap="closeNoBackdrop">Close</sr-button>
    </view>
  </sr-popup>
</app-page>
