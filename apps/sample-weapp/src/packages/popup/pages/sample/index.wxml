<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <sr-navbar
    className="sticky top-0 z-20 border-b border-slate-200"
    title="Popup"
    withBack="{{true}}"
    hasSafeTop="{{true}}"
  />

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Basic</view>
      <view class="mt-3 flex flex-wrap gap-3">
        <sr-button bind:tap="openBasic">Open Popup</sr-button>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Backdrop</view>
      <view class="mt-3 flex flex-wrap gap-2">
        <sr-button data-backdrop="opaque" variant="outline" bind:tap="openBackdrop">
          Opaque
        </sr-button>
        <sr-button data-backdrop="blur" variant="outline" bind:tap="openBackdrop">
          Blur
        </sr-button>
        <sr-button data-backdrop="transparent" variant="outline" bind:tap="openBackdrop">
          Transparent
        </sr-button>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Non Dismissable</view>
      <view class="mt-3 flex flex-wrap gap-3">
        <sr-button bind:tap="openLocked">Open Locked</sr-button>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">No Backdrop</view>
      <view class="mt-3 flex flex-wrap gap-3">
        <sr-button bind:tap="openNoBackdrop">Open Popup</sr-button>
      </view>
    </view>
  </view>

  <sr-popup
    isOpen="{{basicOpen}}"
    bind:openchange="handleBasicChange"
  >
    <view slot="header">Basic Popup</view>
    <view slot="body">This is a basic popup message.</view>
    <view slot="footer" class="flex items-center justify-end gap-2">
      <sr-button variant="text" bind:tap="closeBasic">Cancel</sr-button>
      <sr-button bind:tap="closeBasic">Confirm</sr-button>
    </view>
  </sr-popup>

  <sr-popup
    isOpen="{{backdropOpen}}"
    backdrop="{{backdropValue}}"
    bind:openchange="handleBackdropChange"
  >
    <view slot="header">Backdrop: {{backdropValue}}</view>
    <view slot="body">Switch between backdrop styles.</view>
    <view slot="footer" class="flex items-center justify-end gap-2">
      <sr-button variant="text" bind:tap="closeBackdrop">Close</sr-button>
    </view>
  </sr-popup>

  <sr-popup
    isOpen="{{lockedOpen}}"
    isDismissable="{{false}}"
    bind:openchange="handleLockedChange"
  >
    <view slot="header">Locked Popup</view>
    <view slot="body">Backdrop clicks are disabled. Use the button to close.</view>
    <view slot="footer" class="flex items-center justify-end gap-2">
      <sr-button variant="text" bind:tap="closeLocked">Close</sr-button>
    </view>
  </sr-popup>

  <sr-popup
    isOpen="{{noBackdropOpen}}"
    hasBackdrop="{{false}}"
    bind:openchange="handleNoBackdropChange"
  >
    <view slot="header">No Backdrop</view>
    <view slot="body">Popup without a backdrop.</view>
    <view slot="footer" class="flex items-center justify-end gap-2">
      <sr-button variant="text" bind:tap="closeNoBackdrop">Close</sr-button>
    </view>
  </sr-popup>
</view>
