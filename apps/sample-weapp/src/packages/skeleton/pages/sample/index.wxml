<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <sr-navbar
    className="sticky top-0 z-20 border-b border-slate-200"
    title="Skeleton"
    withBack="{{true}}"
    hasSafeTop="{{true}}"
  />

  <view class="p-4 flex flex-col gap-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Basic</view>
      <view class="mt-1 text-xs text-slate-500">isLoaded 控制占位层与内容切换</view>

      <view class="mt-3">
        <sr-button size="sm" variant="flat" color="primary" bind:tap="toggleLoaded">
          {{isLoaded ? '显示骨架' : '显示内容'}}
        </sr-button>
      </view>

      <view class="mt-3">
        <sr-skeleton isLoaded="{{isLoaded}}" className="w-full rounded-2xl border border-slate-200 p-4">
          <view class="text-sm font-semibold text-slate-900">Skeleton Content</view>
          <view class="mt-2 text-xs leading-5 text-slate-600">
            加载完成后展示真实内容，未完成时展示占位。
          </view>
        </sr-skeleton>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Radius</view>
      <view class="mt-1 text-xs text-slate-500">none / sm / md / lg / full</view>

      <view class="mt-3 flex flex-col gap-3">
        <view wx:for="{{radiusOptions}}" wx:key="value" class="flex items-center gap-3">
          <view class="w-12 shrink-0 text-xs text-slate-500">{{item.label}}</view>
          <view class="flex-1">
            <sr-skeleton radius="{{item.value}}" className="h-10 w-full">
              <view class="h-10 w-full" />
            </sr-skeleton>
          </view>
        </view>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Card</view>
      <view class="mt-1 text-xs text-slate-500">常见信息卡占位</view>

      <view class="mt-3">
        <sr-button size="sm" variant="flat" color="secondary" bind:tap="toggleCardLoaded">
          {{isCardLoaded ? '重置为骨架' : '加载卡片'}}
        </sr-button>
      </view>

      <view class="mt-3">
        <sr-skeleton
          isLoaded="{{isCardLoaded}}"
          radius="lg"
          className="w-full rounded-2xl border border-slate-200 p-4"
        >
          <view class="flex items-start gap-3">
            <view class="h-10 w-10 rounded-full bg-slate-200" />
            <view class="flex-1">
              <view class="text-sm font-semibold text-slate-900">Srcube UI</view>
              <view class="mt-1 text-xs text-slate-600">跨 React 与 Mini 的组件实现。</view>
            </view>
          </view>
        </sr-skeleton>
      </view>
    </view>
  </view>
</view>
