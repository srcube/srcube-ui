<app-page title="Skeleton" tone="{{tone}}" withBack="{{true}}" contentClassName="p-4 flex flex-col gap-6">
  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Basic</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">isLoaded 控制占位层与内容切换</view>

    <view class="mt-3">
      <sr-button size="sm" variant="flat" color="primary" tone="{{tone === 'dark' ? 'dark' : 'light'}}" bind:tap="toggleLoaded">
        {{isLoaded ? '显示骨架' : '显示内容'}}
      </sr-button>
    </view>

    <view class="mt-3">
      <sr-skeleton
        tone="{{tone}}"
        isLoaded="{{isLoaded}}"
        className="w-full rounded-2xl border {{tone === 'dark' ? 'border-zinc-800 bg-zinc-950' : 'border-slate-200 bg-white'}} p-4"
      >
        <view class="text-sm font-semibold {{tone === 'dark' ? 'text-zinc-50' : 'text-slate-900'}}">Skeleton Content</view>
        <view class="mt-2 text-xs leading-5 {{tone === 'dark' ? 'text-zinc-300' : 'text-slate-600'}}">
          加载完成后展示真实内容，未完成时展示占位。
        </view>
      </sr-skeleton>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Radius</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">none / sm / md / lg / full</view>

    <view class="mt-3 flex flex-col gap-3">
      <view wx:for="{{radiusOptions}}" wx:key="value" class="flex items-center gap-3">
        <view class="w-12 shrink-0 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">{{item.label}}</view>
        <view class="flex-1">
          <sr-skeleton tone="{{tone}}" radius="{{item.value}}" className="h-10 w-full">
            <view class="h-10 w-full" />
          </sr-skeleton>
        </view>
      </view>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Card</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">常见信息卡占位</view>

    <view class="mt-3">
      <sr-button size="sm" variant="flat" color="secondary" tone="{{tone === 'dark' ? 'dark' : 'light'}}" bind:tap="toggleCardLoaded">
        {{isCardLoaded ? '重置为骨架' : '加载卡片'}}
      </sr-button>
    </view>

    <view class="mt-3">
      <sr-skeleton
        tone="{{tone}}"
        isLoaded="{{isCardLoaded}}"
        radius="lg"
        className="w-full rounded-2xl border {{tone === 'dark' ? 'border-zinc-800 bg-zinc-950' : 'border-slate-200 bg-white'}} p-4"
      >
        <view class="flex items-start gap-3">
          <view class="h-10 w-10 rounded-full {{tone === 'dark' ? 'bg-zinc-800' : 'bg-slate-200'}}" />
          <view class="flex-1">
            <view class="text-sm font-semibold {{tone === 'dark' ? 'text-zinc-50' : 'text-slate-900'}}">Srcube UI</view>
            <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-300' : 'text-slate-600'}}">跨 React 与 Mini 的组件实现。</view>
          </view>
        </view>
      </sr-skeleton>
    </view>
  </view>
</app-page>
