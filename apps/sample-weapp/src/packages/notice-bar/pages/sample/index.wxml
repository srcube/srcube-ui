<app-page title="Notice Bar" description="用于展示不打断流程的轻提示信息，适合公告、提醒和状态通知。" tone="{{tone}}" withBack="{{true}}">
  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Basic</view>
    <view class="mt-3">
      <sr-notice-bar icon="!" text="系统维护中，部分功能可能受影响。" tone="{{tone}}" />
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Colors</view>
    <view class="mt-3 space-y-2">
      <view><sr-notice-bar color="default" tone="{{tone}}" text="默认提示" /></view>
      <view><sr-notice-bar color="info" tone="{{tone}}" text="信息提示" /></view>
      <view><sr-notice-bar color="success" tone="{{tone}}" text="成功提示" /></view>
      <view><sr-notice-bar color="warning" tone="{{tone}}" text="警告提示" /></view>
      <view><sr-notice-bar color="danger" tone="{{tone}}" text="危险提示" /></view>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Auto Switch / Marquee</view>
    <view class="mt-3 space-y-2">
      <view>
        <sr-notice-bar
          icon="!"
          items="{{noticeItems}}"
          isAutoPlay="{{true}}"
          tone="{{tone}}"
          switchInterval="{{switchInterval}}"
          marqueeDuration="{{marqueeDuration}}"
        />
      </view>
      <view>
        <sr-notice-bar
          color="info"
          tone="{{tone}}"
          text="这是一条超长文案示例，用于展示从右向左移动的文字轮播动画。"
          isMarquee="{{true}}"
          marqueeDuration="{{marqueeDuration}}"
        />
      </view>
    </view>
    <view class="mt-3 space-y-2">
      <view class="text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">切换间隔（switchInterval）</view>
      <sr-button-group size="sm" isBlock tone="{{tone === 'dark' ? 'dark' : 'light'}}">
        <block wx:for="{{switchIntervalOptions}}" wx:for-item="option" wx:key="value">
          <sr-button
            color="{{switchInterval === option.value ? 'primary' : 'default'}}"
            variant="{{switchInterval === option.value ? 'solid' : 'flat'}}"
            data-value="{{option.value}}"
            bind:tap="handleSwitchIntervalTap"
          >
            {{option.label}}
          </sr-button>
        </block>
      </sr-button-group>

      <view class="text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">文字滚动时长（marqueeDuration）</view>
      <sr-button-group size="sm" isBlock tone="{{tone === 'dark' ? 'dark' : 'light'}}">
        <block wx:for="{{marqueeDurationOptions}}" wx:for-item="option" wx:key="value">
          <sr-button
            color="{{marqueeDuration === option.value ? 'primary' : 'default'}}"
            variant="{{marqueeDuration === option.value ? 'solid' : 'flat'}}"
            data-value="{{option.value}}"
            bind:tap="handleMarqueeDurationTap"
          >
            {{option.label}}
          </sr-button>
        </block>
      </sr-button-group>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Sizes / Closable</view>
    <view class="mt-3 space-y-2">
      <view>
        <sr-notice-bar size="sm" tone="{{tone}}" text="Small" isClosable="{{true}}" />
      </view>
      <view>
        <sr-notice-bar
          size="md"
          tone="{{tone}}"
          text="Medium"
          actionText="查看"
          isClosable="{{true}}"
          isVisible="{{visible}}"
          bind:visibleChange="handleVisibleChange"
        />
      </view>
      <view>
        <sr-notice-bar size="lg" tone="{{tone}}" text="Large" isClosable="{{true}}" />
      </view>
    </view>
  </view>
</app-page>
