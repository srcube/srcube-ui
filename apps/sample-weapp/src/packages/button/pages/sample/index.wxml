<app-page title="Button" description="用于触发操作，支持统一的样式、尺寸和状态。适合主流程操作、次级操作和成组按钮。" tone="{{tone}}" withBack="{{true}}">
  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Colors</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-300' : 'text-slate-500'}}">color + variant=solid + tone={{buttonTone}}</view>
    <view class="mt-3 flex flex-wrap gap-2">
      <sr-button color="default" tone="{{buttonTone}}">Default</sr-button>
      <sr-button color="primary" tone="{{buttonTone}}">Primary</sr-button>
      <sr-button color="secondary" tone="{{buttonTone}}">Secondary</sr-button>
      <sr-button color="success" tone="{{buttonTone}}">Success</sr-button>
      <sr-button color="warning" tone="{{buttonTone}}">Warning</sr-button>
      <sr-button color="danger" tone="{{buttonTone}}">Danger</sr-button>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Variants</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-300' : 'text-slate-500'}}">color=default + tone={{buttonTone}}</view>
    <view class="mt-3 flex flex-wrap gap-2">
      <sr-button variant="solid" tone="{{buttonTone}}">Solid</sr-button>
      <sr-button variant="outline" tone="{{buttonTone}}">Outline</sr-button>
      <sr-button variant="flat" tone="{{buttonTone}}">Flat</sr-button>
      <sr-button variant="text" tone="{{buttonTone}}">Text</sr-button>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Sizes</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-300' : 'text-slate-500'}}">color=default + tone={{buttonTone}}</view>
    <view class="mt-3 flex flex-wrap gap-2">
      <sr-button size="sm" tone="{{buttonTone}}">Small</sr-button>
      <sr-button size="md" tone="{{buttonTone}}">Medium</sr-button>
      <sr-button size="lg" tone="{{buttonTone}}">Large</sr-button>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Radius</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-300' : 'text-slate-500'}}">color=default + tone={{buttonTone}}</view>
    <view class="mt-3 flex flex-wrap gap-2">
      <sr-button radius="none" tone="{{buttonTone}}">None</sr-button>
      <sr-button radius="sm" tone="{{buttonTone}}">Small</sr-button>
      <sr-button radius="md" tone="{{buttonTone}}">Medium</sr-button>
      <sr-button radius="lg" tone="{{buttonTone}}">Large</sr-button>
      <sr-button radius="full" tone="{{buttonTone}}">Full</sr-button>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">States</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-300' : 'text-slate-500'}}">color=default + tone={{buttonTone}}</view>
    <view class="mt-3 flex flex-wrap gap-2">
      <sr-button tone="{{buttonTone}}">Normal</sr-button>
      <sr-button isDisabled tone="{{buttonTone}}">Disabled</sr-button>
      <sr-button isLoading tone="{{buttonTone}}">Loading</sr-button>
      <sr-button isLoading="auto" tone="{{buttonTone}}" bind:tap="handleAutoLoading">
        Auto Loading
      </sr-button>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">OpenType</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-300' : 'text-slate-500'}}">color=default + tone={{buttonTone}}</view>
    <view class="mt-3 flex flex-wrap gap-2">
      <sr-button openType="share" tone="{{buttonTone}}">Share</sr-button>
      <sr-button openType="contact" tone="{{buttonTone}}">Contact</sr-button>
      <sr-button openType="openSetting" tone="{{buttonTone}}">Open Setting</sr-button>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Icon</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-300' : 'text-slate-500'}}">color=default + tone={{buttonTone}}</view>
    <view class="mt-3 flex flex-wrap gap-2">
      <sr-button isIcon tone="{{buttonTone}}" aria-label="Add">
        +
      </sr-button>
      <sr-button tone="{{buttonTone}}">
        +
        <text>Star</text>
      </sr-button>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Block</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-300' : 'text-slate-500'}}">color=default + tone={{buttonTone}}</view>
    <view class="mt-3 flex flex-col gap-2">
      <sr-button isBlock tone="{{buttonTone}}">Block Button</sr-button>
      <sr-button isBlock variant="outline" tone="{{buttonTone}}">Outline Block</sr-button>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">ButtonGroup</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-300' : 'text-slate-500'}}">group tone = {{buttonTone}}</view>
    <view class="mt-3 flex flex-col gap-3">
      <sr-button-group tone="{{buttonTone}}">
        <sr-button>Left</sr-button>
        <sr-button>Middle</sr-button>
        <sr-button>Right</sr-button>
      </sr-button-group>
      <sr-button-group tone="{{buttonTone}}" isBlock>
        <sr-button class="flex-1">Yes</sr-button>
        <sr-button variant="outline" class="flex-1">No</sr-button>
      </sr-button-group>
      <sr-button-group tone="{{buttonTone}}" isBlock>
        <sr-button color="primary" class="flex-1">Accept</sr-button>
        <sr-button color="primary" variant="outline" class="flex-1">Later</sr-button>
      </sr-button-group>
    </view>
  </view>
</app-page>
