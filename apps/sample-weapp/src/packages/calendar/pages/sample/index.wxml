<app-page title="Calendar" description="用于在结构化日历视图中浏览和选择日期，适合日程安排、可用性展示和日期相关流程。" tone="{{tone}}" withBack="{{true}}">
  <view class="p-4 space-y-6">
    <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
      <view class="text-sm font-semibold">Single</view>
      <view class="mt-3">
        <sr-calendar
          value="{{singleValue}}"
          min-date="1900-01-01"
          max-date="2099-12-31"
          disabled-dates="{{['2026-01-09','2026-02-20','2026-03-12']}}"
          helper-text="Selected: {{singleValue}}"
          bind:valuechange="handleSingleValueChange"
        />
      </view>
    </view>

    <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
      <view class="text-sm font-semibold">Range</view>
      <view class="mt-3">
        <sr-calendar
          mode="range"
          range-value="{{rangeValue}}"
          color="secondary"
          min-date="1900-01-01"
          max-date="2099-12-31"
          bind:valuechange="handleRangeValueChange"
        />
      </view>
    </view>
  </view>
</app-page>
