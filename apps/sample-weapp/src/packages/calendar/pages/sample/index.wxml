<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <sr-navbar
    className="sticky top-0 z-20 border-b border-slate-200"
    title="Calendar"
    withBack="{{true}}"
    hasSafeTop="{{true}}"
  />

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Single</view>
      <view class="mt-3">
        <sr-calendar
          value="{{singleValue}}"
          min-date="1900-01-01"
          max-date="2099-12-31"
          disabled-dates="{{['2026-01-09','2026-02-20','2026-03-12']}}"
          helper-text="Selected: {{singleValue}}"
          bind:valuechange="handleSingleValueChange"
        />
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Range</view>
      <view class="mt-3">
        <sr-calendar
          mode="range"
          range-value="{{rangeValue}}"
          color="secondary"
          min-date="1900-01-01"
          max-date="2099-12-31"
          bind:valuechange="handleRangeValueChange"
        />
      </view>
    </view>
  </view>
</view>
