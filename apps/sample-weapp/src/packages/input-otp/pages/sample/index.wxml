<app-page title="Input OTP" description="用于输入一次性验证码，支持分段输入和焦点引导。适合验证和安全确认流程。" tone="{{tone}}" withBack="{{true}}">
  <view class="{{tone === 'dark' ? 'bg-zinc-950 text-zinc-50' : 'bg-slate-100 text-slate-900'}} pb-safe">
    <view class="p-4 space-y-6">
    <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
      <view class="text-sm font-semibold">Basic</view>
      <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">controlled + onComplete + length=6</view>
      <view class="mt-3 flex flex-col gap-3">
        <sr-input-otp
          value="{{value}}"
          length="6"
          variant="outline"
          bind:valuechange="handleValueChange"
          bind:complete="handleComplete"
        />
        <view class="text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">Value: {{value || 'empty'}}</view>
        <view class="text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
          Completed: {{completeValue || 'not completed'}}
        </view>
      </view>
    </view>

    <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
      <view class="text-sm font-semibold">Variants</view>
      <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">default / outline / twotone / underline</view>
      <view class="mt-3 flex flex-col gap-3">
        <sr-input-otp defaultValue="12"  tone="{{tone}}" />
        <sr-input-otp defaultValue="12" variant="outline"  tone="{{tone}}" />
        <sr-input-otp defaultValue="12" variant="twotone"  tone="{{tone}}" />
        <sr-input-otp defaultValue="12" variant="underline"  tone="{{tone}}" />
      </view>
    </view>

    <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
      <view class="text-sm font-semibold">Sizes</view>
      <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">sm / md / lg</view>
      <view class="mt-3 flex flex-col gap-3">
        <sr-input-otp size="sm" defaultValue="123"  tone="{{tone}}" />
        <sr-input-otp size="md" defaultValue="123"  tone="{{tone}}" />
        <sr-input-otp size="lg" defaultValue="123"  tone="{{tone}}" />
      </view>
    </view>

    <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
      <view class="text-sm font-semibold">States</view>
      <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">disabled / readOnly / password</view>
      <view class="mt-3 flex flex-col gap-3">
        <sr-input-otp isDisabled defaultValue="1234"  tone="{{tone}}" />
        <sr-input-otp isReadOnly defaultValue="5678"  tone="{{tone}}" />
        <sr-input-otp
          isPassword
          value="{{passwordValue}}"
          bind:valuechange="handlePasswordValueChange"
        />
      </view>
    </view>

    <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
      <view class="text-sm font-semibold">Colors</view>
      <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">use 2 sm ButtonGroup to switch color</view>
      <view class="mt-3 w-full">
        <view class="flex flex-col gap-2">
          <block
            wx:for="{{colorGroups}}"
            wx:for-item="group"
            wx:for-index="groupIndex"
            wx:key="groupIndex"
          >
            <sr-button-group size="sm" isBlock>
              <block wx:for="{{group}}" wx:for-item="option" wx:key="value">
                <sr-button
                  class="flex-1"
                  color="{{activeColor === option.value ? option.value : 'default'}}"
                  variant="{{activeColor === option.value ? 'solid' : 'flat'}}"
                  data-color="{{option.value}}"
                  bind:tap="handleColorTap"
                >
                  {{option.label}}
                </sr-button>
              </block>
            </sr-button-group>
          </block>
        </view>

        <sr-input-otp
          className="mt-3"
          color="{{activeColor}}"
          value="{{colorValue}}"
          bind:valuechange="handleColorValueChange"
        />

        <view class="mt-2 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
          Color: {{activeColor}} / Value: {{colorValue || 'empty'}}
        </view>
      </view>
    </view>
  </view>
  </view>
</app-page>