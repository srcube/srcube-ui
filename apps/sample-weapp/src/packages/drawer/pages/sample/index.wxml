<app-page title="Drawer" tone="{{tone}}" withBack="{{true}}">
  <view class="p-4 space-y-6">
    <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
      <view class="text-sm font-semibold">Placement</view>
      <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">left / right / top / bottom</view>
      <view class="mt-3 flex flex-wrap gap-2">
        <sr-button data-placement="left" tone="{{tone === 'dark' ? 'dark' : 'light'}}" variant="outline" bind:tap="openPlacement">
          Left
        </sr-button>
        <sr-button data-placement="right" tone="{{tone === 'dark' ? 'dark' : 'light'}}" variant="outline" bind:tap="openPlacement">
          Right
        </sr-button>
        <sr-button data-placement="top" tone="{{tone === 'dark' ? 'dark' : 'light'}}" variant="outline" bind:tap="openPlacement">
          Top
        </sr-button>
        <sr-button data-placement="bottom" tone="{{tone === 'dark' ? 'dark' : 'light'}}" variant="outline" bind:tap="openPlacement">
          Bottom
        </sr-button>
      </view>
    </view>

    <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
      <view class="text-sm font-semibold">Non Dismissable</view>
      <view class="mt-3 flex flex-wrap gap-2">
        <sr-button tone="{{tone === 'dark' ? 'dark' : 'light'}}" bind:tap="openLocked">Open Locked Drawer</sr-button>
      </view>
    </view>

    <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
      <view class="text-sm font-semibold">Top Drawer + ActionSheet</view>
      <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
        从 top 弹出 Drawer，并在 Drawer 内继续弹出 ActionSheet
      </view>
      <view class="mt-3 flex flex-wrap gap-2">
        <sr-button tone="{{tone === 'dark' ? 'dark' : 'light'}}" bind:tap="openTopActionScene">Open Top Drawer Scene</sr-button>
      </view>
      <view class="mt-2 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
        Result: {{topActionResult}}
      </view>
    </view>
  </view>

  <sr-drawer
    isOpen="{{isOpen}}"
    placement="{{placement}}"
    tone="{{tone}}"
    title="Drawer {{placement}}"
    bind:openchange="handleOpenChange"
  >
    <view slot="body">
      Current placement: <text class="font-medium">{{placement}}</text>
    </view>
    <view slot="footer" class="flex items-center justify-end gap-2">
      <sr-button tone="{{tone === 'dark' ? 'dark' : 'light'}}" variant="text" bind:tap="closePlacement">Close</sr-button>
    </view>
  </sr-drawer>

  <sr-drawer
    isOpen="{{lockedOpen}}"
    placement="right"
    tone="{{tone}}"
    title="Locked Drawer"
    isDismissable="{{false}}"
    bind:openchange="handleLockedOpenChange"
  >
    <view slot="body">Backdrop clicks are disabled.</view>
    <view slot="footer" class="flex items-center justify-end gap-2">
      <sr-button tone="{{tone === 'dark' ? 'dark' : 'light'}}" variant="text" bind:tap="closeLocked">Close</sr-button>
    </view>
  </sr-drawer>

  <sr-drawer
    isOpen="{{topActionDrawerOpen}}"
    placement="top"
    tone="{{tone}}"
    title="Drawer top"
    bind:openchange="handleTopActionDrawerChange"
  >
    <view slot="body" class="space-y-3">
      <view class="text-sm {{tone === 'dark' ? 'text-zinc-300' : 'text-slate-600'}}">
        这个场景用于验证 Drawer(top) 内再打开 ActionSheet。
      </view>
      <sr-button tone="{{tone === 'dark' ? 'dark' : 'light'}}" isBlock="{{true}}" bind:tap="openTopActionSheet">
        Open Action Sheet
      </sr-button>
    </view>
    <view slot="footer" class="flex items-center justify-end gap-2">
      <sr-button tone="{{tone === 'dark' ? 'dark' : 'light'}}" variant="text" bind:tap="closeTopActionDrawer">Close</sr-button>
    </view>
  </sr-drawer>

  <sr-action-sheet
    isOpen="{{topActionSheetOpen}}"
    title="Top Drawer Actions"
    description="从 Drawer 内继续触发的 ActionSheet"
    actions="{{topActionSheetActions}}"
    tone="{{tone}}"
    isInset="{{true}}"
    bind:action="handleTopActionSheetAction"
    bind:change="handleTopActionSheetChange"
  />
</app-page>
