<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <sr-navbar
    className="sticky top-0 z-20 border-b border-slate-200"
    title="Drawer"
    withBack="{{true}}"
    hasSafeTop="{{true}}"
  />

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Placement</view>
      <view class="mt-1 text-xs text-slate-500">left / right / top / bottom</view>
      <view class="mt-3 flex flex-wrap gap-2">
        <sr-button data-placement="left" variant="outline" bind:tap="openPlacement">
          Left
        </sr-button>
        <sr-button data-placement="right" variant="outline" bind:tap="openPlacement">
          Right
        </sr-button>
        <sr-button data-placement="top" variant="outline" bind:tap="openPlacement">
          Top
        </sr-button>
        <sr-button data-placement="bottom" variant="outline" bind:tap="openPlacement">
          Bottom
        </sr-button>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Non Dismissable</view>
      <view class="mt-3 flex flex-wrap gap-2">
        <sr-button bind:tap="openLocked">Open Locked Drawer</sr-button>
      </view>
    </view>
  </view>

  <sr-drawer
    isOpen="{{isOpen}}"
    placement="{{placement}}"
    title="Drawer {{placement}}"
    bind:openchange="handleOpenChange"
  >
    <view slot="body">
      Current placement: <text class="font-medium">{{placement}}</text>
    </view>
    <view slot="footer" class="flex items-center justify-end gap-2">
      <sr-button variant="text" bind:tap="closePlacement">Close</sr-button>
    </view>
  </sr-drawer>

  <sr-drawer
    isOpen="{{lockedOpen}}"
    placement="right"
    title="Locked Drawer"
    isDismissable="{{false}}"
    bind:openchange="handleLockedOpenChange"
  >
    <view slot="body">Backdrop clicks are disabled.</view>
    <view slot="footer" class="flex items-center justify-end gap-2">
      <sr-button variant="text" bind:tap="closeLocked">Close</sr-button>
    </view>
  </sr-drawer>
</view>
