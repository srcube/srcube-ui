<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <sr-navbar
    className="sticky top-0 z-20 border-b border-slate-200"
    title="Listbox"
    withBack="{{true}}"
    hasSafeTop="{{true}}"
  />

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Sticky Vertical</view>
      <view class="mt-1 text-xs text-slate-500">@tanstack/virtual-core + rangeExtractor (orientation=y)</view>
      <sr-listbox
        class="mt-3 h-80 rounded-2xl border border-slate-200"
        className="mt-3 h-80 rounded-2xl border border-slate-200"
        items="{{stickyItems}}"
        estimateSize="44"
        overscan="8"
        hasDivider
        bind:itemtap="handleStickyItemTap"
      />
      <view class="mt-3 text-xs text-slate-500">
        Last Pressed: {{stickyPressed}}
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Sticky Horizontal</view>
      <view class="mt-1 text-xs text-slate-500">orientation=x + sticky section item</view>
      <sr-listbox
        class="mt-3 h-20 rounded-2xl border border-slate-200"
        className="mt-3 h-20 rounded-2xl border border-slate-200"
        orientation="x"
        items="{{horizontalStickyItems}}"
        estimateSize="120"
        overscan="8"
        bind:itemtap="handleHorizontalItemTap"
      />
      <view class="mt-3 text-xs text-slate-500">
        Last Pressed: {{horizontalPressed}}
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Virtualized List</view>
      <view class="mt-1 text-xs text-slate-500">plain mode (1000 items)</view>
      <sr-listbox
        class="mt-3 h-80 rounded-2xl border border-slate-200"
        className="mt-3 h-80 rounded-2xl border border-slate-200"
        items="{{plainItems}}"
        estimateSize="44"
        overscan="8"
        hasDivider
        bind:itemtap="handlePlainItemTap"
      />
      <view class="mt-3 text-xs text-slate-500">
        Last Pressed: {{plainPressed}}
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Empty</view>
      <view class="mt-1 text-xs text-slate-500">locale=zh-CN</view>
      <sr-listbox
        class="mt-3 h-32 rounded-2xl border border-slate-200"
        className="mt-3 h-32 rounded-2xl border border-slate-200"
        items="{{emptyItems}}"
        estimateSize="44"
        locale="zh-CN"
      />
    </view>
  </view>
</view>
