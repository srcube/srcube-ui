<app-page title="Listbox" tone="{{tone}}" withBack="{{true}}">
  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Sticky Vertical</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">@tanstack/virtual-core + rangeExtractor (orientation=y)</view>
    <sr-listbox
      className="mt-3 h-80 rounded-2xl border {{tone === 'dark' ? 'border-zinc-800' : 'border-slate-200'}}"
      items="{{stickyItems}}"
      tone="{{tone}}"
      estimateSize="44"
      overscan="8"
      hasDivider
      bind:itemtap="handleStickyItemTap"
    />
    <view class="mt-3 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
      Last Pressed: {{stickyPressed}}
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Sticky Horizontal</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">orientation=x + sticky section item</view>
    <sr-listbox
      className="mt-3 h-20 rounded-2xl border {{tone === 'dark' ? 'border-zinc-800' : 'border-slate-200'}}"
      orientation="x"
      items="{{horizontalStickyItems}}"
      tone="{{tone}}"
      estimateSize="120"
      overscan="8"
      bind:itemtap="handleHorizontalItemTap"
    />
    <view class="mt-3 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
      Last Pressed: {{horizontalPressed}}
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Virtualized List</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">plain mode (1000 items)</view>
    <sr-listbox
      className="mt-3 h-80 rounded-2xl border {{tone === 'dark' ? 'border-zinc-800' : 'border-slate-200'}}"
      items="{{plainItems}}"
      tone="{{tone}}"
      estimateSize="44"
      overscan="8"
      hasDivider
      bind:itemtap="handlePlainItemTap"
    />
    <view class="mt-3 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">
      Last Pressed: {{plainPressed}}
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Empty</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">locale=zh-CN</view>
    <sr-listbox
      className="mt-3 h-32 rounded-2xl border {{tone === 'dark' ? 'border-zinc-800' : 'border-slate-200'}}"
      items="{{emptyItems}}"
      tone="{{tone}}"
      estimateSize="44"
      locale="zh-CN"
    />
  </view>
</app-page>
