<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <sr-navbar
    className="sticky top-0 z-20 border-b border-slate-200"
    title="Tabbar"
    withBack="{{true}}"
    hasSafeTop="{{true}}"
  />

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Tone</view>
      <view class="mt-3 flex gap-2">
        <sr-button
          size="sm"
          color="{{tone === 'default' ? 'primary' : 'default'}}"
          variant="{{tone === 'default' ? 'solid' : 'flat'}}"
          data-tone="default"
          bind:tap="handleToneTap"
        >
          default
        </sr-button>
        <sr-button
          size="sm"
          tone="dark"
          variant="{{tone === 'dark' ? 'solid' : 'flat'}}"
          data-tone="dark"
          bind:tap="handleToneTap"
        >
          dark
        </sr-button>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Basic</view>
      <sr-tabbar
        className="mt-3"
        tone="{{tone}}"
        items="{{items}}"
        value="{{value}}"
        bind:change="handleChange"
      />
      <view class="mt-2 text-xs text-slate-500">Value: {{value}}</view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Colors</view>
      <view class="mt-3 space-y-2">
        <view>
          <sr-tabbar color="primary" tone="{{tone}}" items="{{items}}" />
        </view>
        <view>
          <sr-tabbar color="success" tone="{{tone}}" size="sm" items="{{items}}" />
        </view>
      </view>
    </view>
  </view>
</view>
