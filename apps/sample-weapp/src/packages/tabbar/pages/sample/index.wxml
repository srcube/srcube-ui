<app-page title="Tabbar" tone="{{tone}}" withBack="{{true}}">
  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Basic</view>
    <sr-tabbar
      className="mt-3"
      tone="{{tone}}"
      items="{{items}}"
      value="{{value}}"
      bind:change="handleChange"
    />
    <view class="mt-2 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">Value: {{value}}</view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Colors</view>
    <view class="mt-3 space-y-2">
      <view>
        <sr-tabbar color="primary" tone="{{tone}}" items="{{items}}" />
      </view>
      <view>
        <sr-tabbar color="success" tone="{{tone}}" size="sm" items="{{items}}" />
      </view>
    </view>
  </view>
</app-page>
