<app-page title="Scrollbox" tone="{{tone}}" withBack="{{true}}">
  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Vertical</view>
    <view class="mt-3 h-56">
      <sr-scrollbox orientation="y" tone="{{tone}}" className="h-full rounded-2xl border {{tone === 'dark' ? 'border-zinc-800 bg-zinc-950' : 'border-slate-200 bg-white'}}">
        <view class="space-y-3 p-4">
          <view wx:for="{{items}}" wx:key="id" class="flex items-center justify-center h-12 rounded-xl {{tone === 'dark' ? 'bg-zinc-800 text-zinc-100' : 'bg-slate-100 text-slate-700'}} px-4 text-sm font-semibold">
            {{item.label}}
          </view>
        </view>
      </sr-scrollbox>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Horizontal</view>
    <view class="mt-3">
      <sr-scrollbox orientation="x" tone="{{tone}}" className="h-fit rounded-2xl border {{tone === 'dark' ? 'border-zinc-800 bg-zinc-950' : 'border-slate-200 bg-white'}}">
        <view class="flex gap-3 p-4">
          <view wx:for="{{cards}}" wx:key="id" class="inline-flex h-16 w-32 items-center justify-center rounded-xl {{tone === 'dark' ? 'bg-zinc-800 text-zinc-100' : 'bg-slate-100 text-slate-700'}} text-sm font-semibold">
            {{item.label}}
          </view>
        </view>
      </sr-scrollbox>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Both (xy)</view>
    <view class="mt-3 h-48">
      <sr-scrollbox orientation="xy" tone="{{tone}}" className="h-full rounded-2xl border {{tone === 'dark' ? 'border-zinc-800 bg-zinc-950' : 'border-slate-200 bg-white'}}">
        <view class="grid w-[520px] h-[320px] grid-cols-4 gap-3 p-4">
          <view wx:for="{{items}}" wx:key="id" class="flex h-full items-center justify-center rounded-xl {{tone === 'dark' ? 'bg-zinc-800 text-zinc-100' : 'bg-slate-100 text-slate-700'}} text-xs font-semibold">
            {{item.label}}
          </view>
        </view>
      </sr-scrollbox>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Hide Masks</view>
    <view class="mt-3 h-48">
      <sr-scrollbox hideMasks tone="{{tone}}" className="h-full rounded-2xl border {{tone === 'dark' ? 'border-zinc-800 bg-zinc-950' : 'border-slate-200 bg-white'}}">
        <view class="flex flex-col space-y-3 p-4">
          <view wx:for="{{items}}" wx:key="id" class="flex items-center justify-center h-10 rounded-xl {{tone === 'dark' ? 'bg-zinc-800 text-zinc-100' : 'bg-slate-100 text-slate-700'}} px-4 text-sm font-semibold">
            {{item.label}}
          </view>
        </view>
      </sr-scrollbox>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'bg-zinc-900 text-zinc-50 shadow-black/20' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Show Scrollbar</view>
    <view class="mt-3 h-48">
      <sr-scrollbox showScrollbar tone="{{tone}}" className="h-full rounded-2xl border {{tone === 'dark' ? 'border-zinc-800 bg-zinc-950' : 'border-slate-200 bg-white'}}">
        <view class="flex flex-col space-y-3 p-4">
          <view wx:for="{{items}}" wx:key="id" class="flex items-center justify-center h-10 rounded-xl {{tone === 'dark' ? 'bg-zinc-800 text-zinc-100' : 'bg-slate-100 text-slate-700'}} px-4 text-sm font-semibold">
            {{item.label}}
          </view>
        </view>
      </sr-scrollbox>
    </view>
  </view>
</app-page>
