<app-page title="Swipe Action" description="用于在列表项上通过滑动手势展示次级操作，适合收件箱、管理列表和节省空间的操作场景。" tone="{{tone}}" withBack="{{true}}">
  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Basic</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">左右滑动揭示动作按钮</view>

    <view class="mt-3">
      <sr-swipe-action leftActions="{{leftActions}}" rightActions="{{rightActions}}" tone="{{tone}}" bind:action="handleAction">
        <view class="flex h-12 items-center {{tone === 'dark' ? 'bg-zinc-950 text-zinc-100' : 'bg-white text-slate-900'}} px-4">订单 #1001</view>
      </sr-swipe-action>
    </view>

    <view class="mt-2 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">Last Action: {{lastAction}}</view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Controlled</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">openDirection 受控模式</view>

    <view class="mt-3 flex gap-2">
      <sr-button size="sm" tone="{{tone === 'dark' ? 'dark' : 'light'}}" variant="flat" data-direction="left" bind:tap="handleDirectionTap">Open Left</sr-button>
      <sr-button size="sm" tone="{{tone === 'dark' ? 'dark' : 'light'}}" variant="flat" data-direction="right" bind:tap="handleDirectionTap">Open Right</sr-button>
      <sr-button size="sm" tone="{{tone === 'dark' ? 'dark' : 'light'}}" variant="flat" data-direction="none" bind:tap="handleDirectionTap">Close</sr-button>
    </view>

    <view class="mt-3">
      <sr-swipe-action leftActions="{{leftActions}}" rightActions="{{rightActions}}" tone="{{tone}}" openDirection="{{controlledDirection}}" bind:openchange="handleControlledOpenChange" bind:action="handleAction">
        <view class="flex h-12 items-center {{tone === 'dark' ? 'bg-zinc-950 text-zinc-100' : 'bg-white text-slate-900'}} px-4">受控行 #2001</view>
      </sr-swipe-action>
    </view>

    <view class="mt-2 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">Open Direction: {{controlledDirection}}</view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">Sizes</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">sm / md / lg</view>
    <view class="mt-3 space-y-3">
      <view><sr-swipe-action leftActions="{{leftActions}}" rightActions="{{rightActions}}" tone="{{tone}}" size="sm"><view class="flex h-12 items-center {{tone === 'dark' ? 'bg-zinc-950 text-zinc-100' : 'bg-white text-slate-900'}} px-4">Small</view></sr-swipe-action></view>
      <view><sr-swipe-action leftActions="{{leftActions}}" rightActions="{{rightActions}}" tone="{{tone}}" size="md"><view class="flex h-12 items-center {{tone === 'dark' ? 'bg-zinc-950 text-zinc-100' : 'bg-white text-slate-900'}} px-4">Medium</view></sr-swipe-action></view>
      <view><sr-swipe-action leftActions="{{leftActions}}" rightActions="{{rightActions}}" tone="{{tone}}" size="lg"><view class="flex h-12 items-center {{tone === 'dark' ? 'bg-zinc-950 text-zinc-100' : 'bg-white text-slate-900'}} px-4">Large</view></sr-swipe-action></view>
    </view>
  </view>

  <view class="rounded-2xl p-4 shadow-sm {{tone === 'dark' ? 'border border-zinc-800 bg-black text-zinc-50 shadow-black/30' : 'bg-white text-slate-900'}}">
    <view class="text-sm font-semibold">States</view>
    <view class="mt-1 text-xs {{tone === 'dark' ? 'text-zinc-400' : 'text-slate-500'}}">disabled / custom action style</view>

    <view class="mt-3 space-y-3">
      <view>
        <sr-swipe-action leftActions="{{leftActions}}" rightActions="{{rightActions}}" tone="{{tone}}" isDisabled>
          <view class="flex h-12 items-center {{tone === 'dark' ? 'bg-zinc-950 text-zinc-100' : 'bg-white text-slate-900'}} px-4">Disabled</view>
        </sr-swipe-action>
      </view>

      <view>
        <sr-swipe-action leftActions="{{customLeftActions}}" rightActions="{{customRightActions}}" tone="{{tone}}" bind:action="handleAction">
          <view class="flex h-12 items-center {{tone === 'dark' ? 'bg-zinc-950 text-zinc-100' : 'bg-white text-slate-900'}} px-4">Custom Action</view>
        </sr-swipe-action>
      </view>
    </view>
  </view>
</app-page>
