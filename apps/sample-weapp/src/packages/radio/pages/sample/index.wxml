<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <sr-navbar
    className="sticky top-0 z-20 border-b border-slate-200"
    title="Radio"
    withBack="{{true}}"
    hasSafeTop="{{true}}"
  />

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Colors</view>
      <view class="mt-3">
        <sr-radio-group
          value="{{colorValue}}"
          bind:change="handleColorChange"
          orientation="y"
          isBlock
        >
          <sr-radio
            wx:for="{{colors}}"
            wx:key="value"
            value="{{item.value}}"
            color="{{item.value}}"
          >
            {{item.label}}
          </sr-radio>
        </sr-radio-group>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Sizes</view>
      <view class="mt-3">
        <sr-radio-group
          value="{{sizeValue}}"
          bind:change="handleSizeChange"
          orientation="y"
          isBlock
        >
          <sr-radio
            wx:for="{{sizes}}"
            wx:key="value"
            value="{{item.value}}"
            size="{{item.value}}"
          >
            {{item.label}}
          </sr-radio>
        </sr-radio-group>
      </view>
    </view>


    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Custom Icon</view>
      <view class="mt-3 flex flex-wrap gap-4">
        <sr-radio defaultSelected hasIcon>
          <view slot="icon" class="icon-[ion--checkmark]" />
          Check
        </sr-radio>
        <sr-radio hasIcon>
          <view slot="icon" class="icon-[ion--chevron-back]" />
          Chevron
        </sr-radio>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">States</view>
      <view class="mt-3 flex flex-wrap gap-4">
        <sr-radio defaultSelected>Normal</sr-radio>
        <sr-radio isDisabled>Disabled</sr-radio>
        <sr-radio isLoading>Loading</sr-radio>
        <sr-radio isLoading="auto" bind:tap="handleAutoLoading">
          Auto Loading
        </sr-radio>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Group</view>
      <view class="mt-3 space-y-4">
        <sr-radio-group
          value="{{groupValue}}"
          bind:change="handleGroupChange"
          orientation="y"
          isBlock
        >
          <sr-radio value="left">Left</sr-radio>
          <sr-radio value="middle">Middle</sr-radio>
          <sr-radio value="right">Right</sr-radio>
        </sr-radio-group>
        <sr-radio-group defaultValue="a" orientation="x">
          <sr-radio value="a">Option A</sr-radio>
          <sr-radio value="b">Option B</sr-radio>
        </sr-radio-group>
      </view>
    </view>
  </view>
</view>
