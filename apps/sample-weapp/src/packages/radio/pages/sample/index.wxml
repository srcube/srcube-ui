<app-page title="Radio" description="用于在一组选项中单选一个，适合偏好设置、模式切换和单选表单。" tone="{{tone}}" withBack="{{true}}">
  <view class="{{surfaceClassName}}">
    <view class="{{titleClassName}}">Colors</view>
    <view class="{{descriptionClassName}}">color variants</view>
    <view class="mt-3">
      <sr-radio-group value="{{colorValue}}" tone="{{tone}}" bind:change="handleColorChange" orientation="y" isBlock>
        <sr-radio wx:for="{{colors}}" wx:key="value" value="{{item.value}}" color="{{item.value}}">{{item.label}}</sr-radio>
      </sr-radio-group>
    </view>
  </view>

  <view class="{{surfaceClassName}}">
    <view class="{{titleClassName}}">Sizes</view>
    <view class="{{descriptionClassName}}">button group controller</view>
    <view class="mt-3 space-y-4">
      <sr-button-group size="sm" isBlock>
        <sr-button
          wx:for="{{sizes}}"
          wx:key="value"
          class="flex-1"
          color="{{sizeValue === item.value ? 'primary' : 'default'}}"
          variant="{{sizeValue === item.value ? 'solid' : 'flat'}}"
          data-value="{{item.value}}"
          bind:tap="handleSizeTap"
        >
          {{item.label}}
        </sr-button>
      </sr-button-group>
      <sr-radio-group value="{{sizeValue}}" tone="{{tone}}" bind:change="handleSizeChange" orientation="y" isBlock>
        <sr-radio wx:for="{{sizes}}" wx:key="value" value="{{item.value}}" size="{{item.value}}">{{item.label}}</sr-radio>
      </sr-radio-group>
    </view>
  </view>

  <view class="{{surfaceClassName}}">
    <view class="{{titleClassName}}">Custom Icon</view>
    <view class="{{descriptionClassName}}">slot icon</view>
    <view class="mt-3 flex flex-wrap gap-4">
      <sr-radio tone="{{tone}}" defaultSelected hasIcon>
        <view slot="icon" class="icon-[ion--checkmark]" />
        Check
      </sr-radio>
      <sr-radio tone="{{tone}}" hasIcon>
        <view slot="icon" class="icon-[ion--chevron-back]" />
        Chevron
      </sr-radio>
    </view>
  </view>

  <view class="{{surfaceClassName}}">
    <view class="{{titleClassName}}">States</view>
    <view class="mt-3 flex flex-wrap gap-4">
      <sr-radio tone="{{tone}}" defaultSelected>Normal</sr-radio>
      <sr-radio tone="{{tone}}" isDisabled>Disabled</sr-radio>
      <sr-radio tone="{{tone}}" isLoading>Loading</sr-radio>
      <sr-radio tone="{{tone}}" isLoading="auto" bind:tap="handleAutoLoading">
        Auto Loading
      </sr-radio>
    </view>
  </view>

  <view class="{{surfaceClassName}}">
    <view class="{{titleClassName}}">Group</view>
    <view class="{{descriptionClassName}}">orientation + isBlock</view>
    <view class="mt-3 space-y-4">
      <sr-radio-group
        value="{{groupValue}}"
        tone="{{tone}}"
        bind:change="handleGroupChange"
        orientation="y"
        isBlock
      >
        <sr-radio value="left">Left</sr-radio>
        <sr-radio value="middle">Middle</sr-radio>
        <sr-radio value="right">Right</sr-radio>
      </sr-radio-group>
      <sr-radio-group defaultValue="a" orientation="x" tone="{{tone}}">
        <sr-radio value="a">Option A</sr-radio>
        <sr-radio value="b">Option B</sr-radio>
      </sr-radio-group>
    </view>
  </view>
</app-page>
