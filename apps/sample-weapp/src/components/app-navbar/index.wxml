    className="{{tone === 'dark' ? 'border-b border-zinc-800' : 'border-b border-slate-200'}}"
    title="{{title}}"
    tone="{{tone}}"
    withBack="{{withBack}}"
    hasSafeTop="{{true}}"
    bind:back="handleBack"
  />
</view>
