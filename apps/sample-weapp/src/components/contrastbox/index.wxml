<view class="contrastbox-root rounded-2xl p-4 {{className}}" style="{{style}};">
  <view style="color: {{foregroundColor}} !important;">
    <slot />
    <view wx:if="{{debug}}" class="mt-3 text-[10px] opacity-80">
      bg: {{debugResolved || 'unknown'}} · rgb: {{debugNormalized || 'invalid'}} · fg: {{foregroundColor}}
      <view class="mt-1 break-all">{{debugQuery}}</view>
    </view>
  </view>
</view>
