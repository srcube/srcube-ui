<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 bg-white border-b border-slate-200">
    <view class="p-4">
      <view class="text-lg font-semibold">Picker</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Type</view>
      <view class="mt-1 text-xs text-slate-500">
        default / calendar（当前均使用 pickbox）
      </view>

      <view class="mt-3">
        <sr-button-group size="sm" isBlock>
          <sr-button
            class="flex-1"
            color="{{pickerType === 'default' ? 'primary' : 'default'}}"
            variant="{{pickerType === 'default' ? 'solid' : 'flat'}}"
            data-type="default"
            bind:tap="handleTypeTap"
          >
            default
          </sr-button>
          <sr-button
            class="flex-1"
            color="{{pickerType === 'calendar' ? 'primary' : 'default'}}"
            variant="{{pickerType === 'calendar' ? 'solid' : 'flat'}}"
            data-type="calendar"
            bind:tap="handleTypeTap"
          >
            calendar
          </sr-button>
        </sr-button-group>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Datetime Mode</view>
      <view class="mt-1 text-xs text-slate-500">datetime / date / time</view>

      <view class="mt-3">
        <sr-button-group size="sm" isBlock>
          <sr-button
            class="flex-1"
            color="{{datetimeMode === 'datetime' ? 'primary' : 'default'}}"
            variant="{{datetimeMode === 'datetime' ? 'solid' : 'flat'}}"
            data-mode="datetime"
            bind:tap="handleDatetimeModeTap"
          >
            datetime
          </sr-button>
          <sr-button
            class="flex-1"
            color="{{datetimeMode === 'date' ? 'primary' : 'default'}}"
            variant="{{datetimeMode === 'date' ? 'solid' : 'flat'}}"
            data-mode="date"
            bind:tap="handleDatetimeModeTap"
          >
            date
          </sr-button>
          <sr-button
            class="flex-1"
            color="{{datetimeMode === 'time' ? 'primary' : 'default'}}"
            variant="{{datetimeMode === 'time' ? 'solid' : 'flat'}}"
            data-mode="time"
            bind:tap="handleDatetimeModeTap"
          >
            time
          </sr-button>
        </sr-button-group>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Single</view>
      <view class="mt-1 text-xs text-slate-500">
        Field + Drawer(bottom) + Pickbox，dismiss=取消
      </view>

      <sr-picker
        className="mt-3"
        label="城市"
        type="{{pickerType}}"
        color="primary"
        items="{{singleItems}}"
        value="{{singleValue}}"
        bind:valuechange="handleSingleValueChange"
      />

      <view class="mt-2 text-xs text-slate-500">
        Value: {{singleValue[0] || 'none'}}
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Multiple</view>
      <view class="mt-1 text-xs text-slate-500">多列选择 + 同步 Confirm 按钮色值/尺寸</view>

      <sr-picker
        className="mt-3"
        label="商品偏好"
        type="{{pickerType}}"
        color="secondary"
        size="sm"
        columns="{{multiColumns}}"
        value="{{multiValue}}"
        bind:valuechange="handleMultiValueChange"
      />

      <view class="mt-2 text-xs text-slate-500">
        Value: {{multiValueText}}
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">DatePicker</view>
      <view class="mt-1 text-xs text-slate-500">1900~2099 单选日期</view>

      <sr-date-picker
        className="mt-3"
        label="日期"
        type="{{pickerType}}"
        color="success"
        value="{{dateValue}}"
        bind:valuechange="handleDateValueChange"
      />

      <view class="mt-2 text-xs text-slate-500">
        Value: {{dateValue || 'none'}}
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">TimePicker</view>
      <view class="mt-1 text-xs text-slate-500">与 DatePicker 一致，改为时/分/秒数据源</view>

      <sr-time-picker
        className="mt-3"
        label="时间"
        type="{{pickerType}}"
        color="warning"
        value="{{timeValue}}"
        bind:valuechange="handleTimeValueChange"
      />

      <view class="mt-2 text-xs text-slate-500">
        Value: {{timeValue || 'none'}}
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">DateRangePicker</view>
      <view class="mt-1 text-xs text-slate-500">
        Drawer body 内使用 Tabs 切换 start/end，对应 Pickbox 选中态联动
      </view>

      <sr-date-range-picker
        className="mt-3"
        label="日期区间"
        type="{{pickerType}}"
        color="primary"
        value="{{dateRangeValue}}"
        bind:valuechange="handleDateRangeValueChange"
      />

      <view class="mt-2 text-xs text-slate-500">
        Value: {{dateRangeValue.start || '--'}} ~ {{dateRangeValue.end || '--'}}
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">PickerDatetime</view>
      <view class="mt-1 text-xs text-slate-500">
        mode + format；mode=datetime 时展示全宽 Date/Time Tab
      </view>

      <sr-picker-datetime
        className="mt-3"
        label="日期时间"
        type="{{pickerType}}"
        color="success"
        size="sm"
        mode="{{datetimeMode}}"
        format="{{datetimeFormat}}"
        value="{{datetimeValue}}"
        bind:valuechange="handleDatetimeValueChange"
      />

      <view class="mt-2 text-xs text-slate-500">
        Value: {{datetimeValue || 'none'}}
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">PickerDatetimeRange</view>
      <view class="mt-1 text-xs text-slate-500">
        start/end + date/time 双层全宽 Tab，支持 format
      </view>

      <sr-picker-datetime-range
        className="mt-3"
        label="日期时间区间"
        type="{{pickerType}}"
        color="primary"
        size="sm"
        mode="{{datetimeMode}}"
        format="{{datetimeFormat}}"
        value="{{datetimeRangeValue}}"
        bind:valuechange="handleDatetimeRangeValueChange"
      />

      <view class="mt-2 text-xs text-slate-500">
        Value: {{datetimeRangeValue.start || '--'}} ~ {{datetimeRangeValue.end || '--'}}
      </view>
    </view>
  </view>
</view>
