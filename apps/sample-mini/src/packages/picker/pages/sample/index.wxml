<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 bg-white border-b border-slate-200">
    <view class="p-4">
      <view class="text-lg font-semibold">Picker</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Type</view>
      <view class="mt-1 text-xs text-slate-500">
        default / calendar（当前均使用 pickbox）
      </view>

      <view class="mt-3">
        <sr-button-group size="sm" isBlock>
          <sr-button
            class="flex-1"
            color="{{pickerType === 'default' ? 'primary' : 'default'}}"
            variant="{{pickerType === 'default' ? 'solid' : 'flat'}}"
            data-type="default"
            bind:tap="handleTypeTap"
          >
            default
          </sr-button>
          <sr-button
            class="flex-1"
            color="{{pickerType === 'calendar' ? 'primary' : 'default'}}"
            variant="{{pickerType === 'calendar' ? 'solid' : 'flat'}}"
            data-type="calendar"
            bind:tap="handleTypeTap"
          >
            calendar
          </sr-button>
        </sr-button-group>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Single</view>
      <view class="mt-1 text-xs text-slate-500">
        Field + Drawer(bottom) + Pickbox，dismiss=取消
      </view>

      <sr-picker
        className="mt-3"
        label="城市"
        type="{{pickerType}}"
        mode="single"
        color="primary"
        items="{{singleItems}}"
        value="{{singleValue}}"
        bind:valuechange="handleSingleValueChange"
      />

      <view class="mt-2 text-xs text-slate-500">
        Value: {{singleValue || 'none'}}
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Multiple</view>
      <view class="mt-1 text-xs text-slate-500">多列选择 + 同步 Confirm 按钮色值/尺寸</view>

      <sr-picker
        className="mt-3"
        label="商品偏好"
        type="{{pickerType}}"
        mode="multiple"
        color="secondary"
        size="sm"
        columns="{{multiColumns}}"
        value="{{multiValue}}"
        bind:valuechange="handleMultiValueChange"
      />

      <view class="mt-2 text-xs text-slate-500">
        Value: {{multiValue.length ? multiValue.join(' / ') : 'none'}}
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">DatePicker</view>
      <view class="mt-1 text-xs text-slate-500">1900~2099 单选日期</view>

      <sr-date-picker
        className="mt-3"
        label="日期"
        type="{{pickerType}}"
        color="success"
        value="{{dateValue}}"
        bind:valuechange="handleDateValueChange"
      />

      <view class="mt-2 text-xs text-slate-500">
        Value: {{dateValue || 'none'}}
      </view>
    </view>
  </view>
</view>
