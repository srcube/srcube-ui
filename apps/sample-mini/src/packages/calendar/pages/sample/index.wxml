<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 bg-white border-b border-slate-200">
    <view class="p-4">
      <view class="text-lg font-semibold">Calendar</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Single</view>
      <view class="mt-3">
        <sr-calendar
          value="{{singleValue}}"
          month="2026-02"
          min-date="2026-02-03"
          max-date="2026-02-26"
          disabled-dates="{{['2026-02-09','2026-02-20']}}"
          helper-text="Selected: {{singleValue}}"
          bind:valuechange="handleSingleValueChange"
        />
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Range</view>
      <view class="mt-3">
        <sr-calendar
          mode="range"
          range-value="{{rangeValue}}"
          month="2026-02"
          color="secondary"
          bind:valuechange="handleRangeValueChange"
        />
      </view>
    </view>
  </view>
</view>
