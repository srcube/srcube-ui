<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 bg-white border-b border-slate-200">
    <view class="p-4">
      <view class="text-lg font-semibold">Action Sheet</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Basic</view>
      <button class="mt-3" bindtap="handleOpen">打开操作面板</button>
      <view class="mt-2 text-xs text-slate-500">Result: {{result}}</view>
    </view>
  </view>

  <sr-action-sheet
    isOpen="{{isOpen}}"
    title="更多操作"
    description="请选择一个操作"
    actions="{{actions}}"
    isInset="{{true}}"
    bind:action="handleAction"
    bind:change="handleChange"
  />
</view>
