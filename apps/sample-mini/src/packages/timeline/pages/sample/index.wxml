<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 bg-white border-b border-slate-200">
    <view class="p-4">
      <view class="text-lg font-semibold">Timeline</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Default</view>
      <view class="mt-3">
        <sr-timeline items="{{productTimeline}}" />
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Dashed / Small</view>
      <view class="mt-3">
        <sr-timeline items="{{dashedTimeline}}" size="sm" line-style="dashed" />
      </view>
    </view>
  </view>
</view>
