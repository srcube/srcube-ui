<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 bg-white border-b border-slate-200">
    <view class="p-4">
      <view class="text-lg font-semibold">Steps</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Horizontal</view>
      <view class="mt-3">
        <sr-steps items="{{checkoutSteps}}" current="{{1}}" />
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Vertical / Dot</view>
      <view class="mt-3">
        <sr-steps
          items="{{checkoutSteps}}"
          current="{{2}}"
          direction="vertical"
          is-dot="{{true}}"
        />
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Custom Status</view>
      <view class="mt-3">
        <sr-steps items="{{issueSteps}}" direction="vertical" size="sm" />
      </view>
    </view>
  </view>
</view>
