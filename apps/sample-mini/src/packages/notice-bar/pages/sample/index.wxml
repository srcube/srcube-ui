<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 bg-white border-b border-slate-200">
    <view class="p-4">
      <view class="text-lg font-semibold">Notice Bar</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Basic</view>
      <view class="mt-3">
        <sr-notice-bar icon="!" text="系统维护中，部分功能可能受影响。" />
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Colors</view>
      <view class="mt-3 space-y-2">
        <view><sr-notice-bar color="default" text="默认提示" /></view>
        <view><sr-notice-bar color="info" text="信息提示" /></view>
        <view><sr-notice-bar color="success" text="成功提示" /></view>
        <view><sr-notice-bar color="warning" text="警告提示" /></view>
        <view><sr-notice-bar color="danger" text="危险提示" /></view>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Sizes / Closable</view>
      <view class="mt-3 space-y-2">
        <view>
          <sr-notice-bar size="sm" text="Small" isClosable="{{true}}" />
        </view>
        <view>
          <sr-notice-bar
            size="md"
            text="Medium"
            actionText="查看"
            isClosable="{{true}}"
            isVisible="{{visible}}"
            bind:visibleChange="handleVisibleChange"
          />
        </view>
        <view>
          <sr-notice-bar size="lg" text="Large" isClosable="{{true}}" />
        </view>
      </view>
    </view>
  </view>
</view>
