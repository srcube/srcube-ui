<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 bg-white border-b border-slate-200">
    <view class="p-4">
      <view class="text-lg font-semibold">Navbar</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Basic</view>
      <sr-navbar className="mt-3" title="{{title}}" />
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">With Actions</view>
      <sr-navbar className="mt-3" title="消息">
        <view slot="start">
          <sr-button size="sm" variant="flat">返回</sr-button>
        </view>
        <view slot="end">
          <sr-button size="sm" variant="flat">更多</sr-button>
        </view>
      </sr-navbar>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Sizes</view>
      <view class="mt-3 space-y-2">
        <view>
          <sr-navbar size="sm" title="Small" />
        </view>
        <view>
          <sr-navbar size="md" title="Medium" />
        </view>
        <view>
          <sr-navbar size="lg" title="Large" />
        </view>
      </view>
    </view>
  </view>
</view>
