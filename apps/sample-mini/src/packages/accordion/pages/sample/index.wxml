<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 bg-white border-b border-slate-200">
    <view class="p-4">
      <view class="text-lg font-semibold">Accordion</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Controlled / Single</view>
      <view class="mt-3">
        <sr-accordion
          items="{{items}}"
          value="{{singleValue}}"
          bind:change="handleSingleChange"
        />
      </view>
      <view class="mt-2 text-xs text-slate-500">Value: {{singleValue}}</view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Controlled / Multiple</view>
      <view class="mt-3">
        <sr-accordion
          items="{{items}}"
          selectionMode="multiple"
          value="{{multipleValues}}"
          variant="twotone"
          bind:change="handleMultipleChange"
        />
      </view>
      <view class="mt-2 text-xs text-slate-500">Values: {{multipleValues}}</view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Sizes</view>
      <view class="mt-3 space-y-2">
        <view>
          <sr-accordion items="{{items}}" size="sm" defaultValue="order" />
        </view>
        <view>
          <sr-accordion items="{{items}}" size="md" defaultValue="order" />
        </view>
        <view>
          <sr-accordion items="{{items}}" size="lg" defaultValue="order" />
        </view>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">States</view>
      <view class="mt-3 space-y-2">
        <view>
          <sr-accordion items="{{disabledItems}}" defaultValue="order" />
        </view>
        <view>
          <sr-accordion items="{{items}}" variant="soft" isSeparated="{{false}}" />
        </view>
        <view>
          <sr-accordion items="{{items}}" defaultValue="order" isDisabled="{{true}}" />
        </view>
      </view>
    </view>
  </view>
</view>
