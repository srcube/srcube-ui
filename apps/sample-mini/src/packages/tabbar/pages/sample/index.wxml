<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 bg-white border-b border-slate-200">
    <view class="p-4">
      <view class="text-lg font-semibold">Tabbar</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Basic</view>
      <sr-tabbar
        className="mt-3"
        items="{{items}}"
        value="{{value}}"
        bind:change="handleChange"
      />
      <view class="mt-2 text-xs text-slate-500">Value: {{value}}</view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Colors</view>
      <view class="mt-3 space-y-2">
        <view>
          <sr-tabbar color="primary" items="{{items}}" />
        </view>
        <view>
          <sr-tabbar color="success" size="sm" items="{{items}}" />
        </view>
      </view>
    </view>
  </view>
</view>
