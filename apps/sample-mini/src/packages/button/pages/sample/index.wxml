<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="border-b border-slate-200 bg-white px-4 py-3 text-base font-semibold">
    Button
  </view>

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Colors</view>
      <view class="mt-3 flex flex-wrap gap-2">
        <sr-button color="default">Default</sr-button>
        <sr-button color="primary">Primary</sr-button>
        <sr-button color="secondary">Secondary</sr-button>
        <sr-button color="success">Success</sr-button>
        <sr-button color="warning">Warning</sr-button>
        <sr-button color="danger">Danger</sr-button>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Variants</view>
      <view class="mt-3 flex flex-wrap gap-2">
        <sr-button variant="solid">Solid</sr-button>
        <sr-button variant="outline">Outline</sr-button>
        <sr-button variant="flat">Flat</sr-button>
        <sr-button variant="text">Text</sr-button>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Sizes</view>
      <view class="mt-3 flex flex-wrap gap-2">
        <sr-button size="sm">Small</sr-button>
        <sr-button size="md">Medium</sr-button>
        <sr-button size="lg">Large</sr-button>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Radius</view>
      <view class="mt-3 flex flex-wrap gap-2">
        <sr-button radius="none">None</sr-button>
        <sr-button radius="sm">Small</sr-button>
        <sr-button radius="md">Medium</sr-button>
        <sr-button radius="lg">Large</sr-button>
        <sr-button radius="full">Full</sr-button>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">States</view>
      <view class="mt-3 flex flex-wrap gap-2">
        <sr-button>Normal</sr-button>
        <sr-button isDisabled>Disabled</sr-button>
        <sr-button isLoading>Loading</sr-button>
        <sr-button isLoading="auto" bind:tap="handleAutoLoading">
          Auto Loading
        </sr-button>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">OpenType</view>
      <view class="mt-3 flex flex-wrap gap-2">
        <sr-button openType="share">Share</sr-button>
        <sr-button openType="contact">Contact</sr-button>
        <sr-button openType="openSetting">Open Setting</sr-button>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Icon</view>
      <view class="mt-3 flex flex-wrap gap-2">
        <sr-button isIcon aria-label="Add">
          +
        </sr-button>
        <sr-button>
          +
          <text>Star</text>
        </sr-button>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Block</view>
      <view class="mt-3 flex flex-col gap-2">
        <sr-button isBlock>Primary Block</sr-button>
        <sr-button isBlock variant="outline">Outline Block</sr-button>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">ButtonGroup</view>
      <view class="mt-3 flex flex-col gap-3">
        <sr-button-group>
          <sr-button>Left</sr-button>
          <sr-button>Middle</sr-button>
          <sr-button>Right</sr-button>
        </sr-button-group>
        <sr-button-group isBlock>
          <sr-button class="flex-1">Yes</sr-button>
          <sr-button variant="outline" class="flex-1">No</sr-button>
        </sr-button-group>
      </view>
    </view>
  </view>
</view>
