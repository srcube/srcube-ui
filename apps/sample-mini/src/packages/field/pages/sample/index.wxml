<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 bg-white border-b border-slate-200">
    <view class="p-4">
      <view class="text-lg font-semibold">Field</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Basic</view>
      <view class="mt-1 text-xs text-slate-500">field 负责表现层，input 逻辑由业务控件承载</view>

      <sr-field
        class="mt-3"
        id="mini-field-phone"
        label="手机号"
        value="{{basicValue}}"
        description="请输入 11 位手机号"
        isClearable
        hasControl="{{true}}"
        hasEndContent
        bind:valuechange="handleBasicValueChange"
        bind:clear="handleBasicClear"
      >
        <input
          id="mini-field-phone"
          class="w-full bg-transparent"
          value="{{basicValue}}"
          placeholder="例如：13800000000"
          bindinput="handleBasicInput"
        />
        <view slot="end" class="flex items-center justify-center">
          <view class="icon-[mingcute--phone-fill]" />
        </view>
      </sr-field>

      <view class="mt-2 text-xs text-slate-500">Value: {{basicValue || 'empty'}}</view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Label Placement</view>
      <view class="mt-1 text-xs text-slate-500">outside / outside-left / inside</view>

      <view class="mt-3 space-y-3">
        <view>
          <sr-field label="Outside" labelPlacement="outside" placeholder="outside" />
        </view>
        <view>
          <sr-field
            label="Left"
            labelPlacement="outside-left"
            placeholder="outside-left"
          />
        </view>
        <view>
          <sr-field label="Inside" labelPlacement="inside" placeholder="inside" />
        </view>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Variants</view>
      <view class="mt-1 text-xs text-slate-500">default / outline / twotone / underline</view>

      <view class="mt-3 space-y-3">
        <sr-field label="Default" value="field value" variant="default" />
        <sr-field label="Outline" value="field value" variant="outline" />
        <sr-field label="Twotone" value="field value" variant="twotone" />
        <sr-field label="Underline" value="field value" variant="underline" />
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Sizes</view>
      <view class="mt-1 text-xs text-slate-500">sm / md / lg</view>

      <view class="mt-3 space-y-3">
        <sr-field label="Small" value="field value" size="sm" />
        <sr-field label="Medium" value="field value" size="md" />
        <sr-field label="Large" value="field value" size="lg" />
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Radius</view>
      <view class="mt-1 text-xs text-slate-500">none / sm / md / lg / full</view>

      <view class="mt-3 space-y-3">
        <sr-field label="Radius None" value="field value" variant="twotone" radius="none" />
        <sr-field label="Radius Sm" value="field value" variant="twotone" radius="sm" />
        <sr-field label="Radius Md" value="field value" variant="twotone" radius="md" />
        <sr-field label="Radius Lg" value="field value" variant="twotone" radius="lg" />
        <sr-field label="Radius Full" value="field value" variant="twotone" radius="full" />
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">States</view>
      <view class="mt-1 text-xs text-slate-500">invalid / disabled / readOnly</view>

      <view class="mt-3 space-y-3">
        <sr-field
          label="Invalid"
          value="invalid value"
          errorMessage="该字段格式不正确"
          variant="outline"
          color="danger"
          isInvalid
        />
        <sr-field
          label="Disabled"
          value="disabled value"
          description="disabled state"
          isDisabled
        />
        <sr-field
          label="Readonly"
          value="readonly value"
          description="readonly state"
          isReadOnly
        />
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Colors</view>
      <view class="mt-1 text-xs text-slate-500">use 2 sm ButtonGroup to switch color</view>

      <view class="mt-3 flex flex-col gap-2">
        <block
          wx:for="{{colorGroups}}"
          wx:for-item="group"
          wx:for-index="groupIndex"
          wx:key="groupIndex"
        >
          <sr-button-group size="sm" isBlock>
            <block wx:for="{{group}}" wx:for-item="option" wx:key="value">
              <sr-button
                class="flex-1"
                color="{{activeColor === option.value ? option.value : 'default'}}"
                variant="{{activeColor === option.value ? 'solid' : 'flat'}}"
                data-color="{{option.value}}"
                bind:tap="handleColorTap"
              >
                {{option.label}}
              </sr-button>
            </block>
          </sr-button-group>
        </block>
      </view>

      <sr-field
        class="mt-3"
        id="mini-field-color"
        label="Color Preview"
        value="{{colorValue}}"
        color="{{activeColor}}"
        isClearable
        hasControl="{{true}}"
        bind:valuechange="handleColorValueChange"
        bind:clear="handleColorClear"
      >
        <input
          id="mini-field-color"
          class="w-full bg-transparent"
          value="{{colorValue}}"
          bindinput="handleColorInput"
        />
      </sr-field>

      <view class="mt-2 text-xs text-slate-500">Color: {{activeColor}}</view>
    </view>
  </view>
</view>
