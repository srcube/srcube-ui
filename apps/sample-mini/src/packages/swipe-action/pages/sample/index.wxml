<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 bg-white border-b border-slate-200">
    <view class="p-4">
      <view class="text-lg font-semibold">Swipe Action</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Basic</view>
      <view class="mt-1 text-xs text-slate-500">左右滑动揭示动作按钮</view>

      <view class="mt-3">
        <sr-swipe-action
          leftActions="{{leftActions}}"
          rightActions="{{rightActions}}"
          bind:action="handleAction"
        >
          <view class="flex h-12 items-center bg-white px-4">订单 #1001</view>
        </sr-swipe-action>
      </view>

      <view class="mt-2 text-xs text-slate-500">Last Action: {{lastAction}}</view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Controlled</view>
      <view class="mt-1 text-xs text-slate-500">openDirection 受控模式</view>

      <view class="mt-3 flex gap-2">
        <sr-button size="sm" variant="flat" data-direction="left" bind:tap="handleDirectionTap">
          Open Left
        </sr-button>
        <sr-button size="sm" variant="flat" data-direction="right" bind:tap="handleDirectionTap">
          Open Right
        </sr-button>
        <sr-button size="sm" variant="flat" data-direction="none" bind:tap="handleDirectionTap">
          Close
        </sr-button>
      </view>

      <view class="mt-3">
        <sr-swipe-action
          leftActions="{{leftActions}}"
          rightActions="{{rightActions}}"
          openDirection="{{controlledDirection}}"
          bind:openchange="handleControlledOpenChange"
          bind:action="handleAction"
        >
          <view class="flex h-12 items-center bg-white px-4">受控行 #2001</view>
        </sr-swipe-action>
      </view>

      <view class="mt-2 text-xs text-slate-500">
        Open Direction: {{controlledDirection}}
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Sizes</view>
      <view class="mt-1 text-xs text-slate-500">sm / md / lg</view>

      <view class="mt-3 space-y-3">
        <view>
          <sr-swipe-action
            leftActions="{{leftActions}}"
            rightActions="{{rightActions}}"
            size="sm"
          >
            <view class="flex h-12 items-center bg-white px-4">Small</view>
          </sr-swipe-action>
        </view>
        <view>
          <sr-swipe-action
            leftActions="{{leftActions}}"
            rightActions="{{rightActions}}"
            size="md"
          >
            <view class="flex h-12 items-center bg-white px-4">Medium</view>
          </sr-swipe-action>
        </view>
        <view>
          <sr-swipe-action
            leftActions="{{leftActions}}"
            rightActions="{{rightActions}}"
            size="lg"
          >
            <view class="flex h-12 items-center bg-white px-4">Large</view>
          </sr-swipe-action>
        </view>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">States</view>
      <view class="mt-1 text-xs text-slate-500">disabled / custom action style</view>

      <view class="mt-3 space-y-3">
        <view>
          <sr-swipe-action leftActions="{{leftActions}}" rightActions="{{rightActions}}" isDisabled>
            <view class="flex h-12 items-center bg-white px-4">Disabled</view>
          </sr-swipe-action>
        </view>

        <view>
          <sr-swipe-action
            leftActions="{{customLeftActions}}"
            rightActions="{{customRightActions}}"
            bind:action="handleAction"
          >
            <view class="flex h-12 items-center bg-white px-4">Custom Action</view>
          </sr-swipe-action>
        </view>
      </view>
    </view>
  </view>
</view>
