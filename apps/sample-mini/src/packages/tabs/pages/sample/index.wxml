<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 bg-white border-b border-slate-200">
    <view class="p-4">
      <view class="text-lg font-semibold">Tabs</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Basic</view>
      <view class="mt-1 text-xs text-slate-500">horizontal + panel (size=md radius=full)</view>

      <sr-tabs
        className="mt-3"
        items="{{basicTabs}}"
        value="{{basicValue}}"
        size="md"
        radius="full"
        bind:change="handleBasicChange"
      >
        <sr-tab-panel
          value="tab-1"
          activeValue="{{basicValue}}"
          className="rounded-2xl border border-slate-200 bg-white p-4"
        >
          Panel for Tab 1
        </sr-tab-panel>
        <sr-tab-panel
          value="tab-2"
          activeValue="{{basicValue}}"
          className="rounded-2xl border border-slate-200 bg-white p-4"
        >
          Panel for Tab 2
        </sr-tab-panel>
        <sr-tab-panel
          value="tab-3"
          activeValue="{{basicValue}}"
          className="rounded-2xl border border-slate-200 bg-white p-4"
        >
          Panel for Tab 3
        </sr-tab-panel>
      </sr-tabs>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Vertical</view>
      <view class="mt-1 text-xs text-slate-500">orientation=y + panel (size=sm radius=lg)</view>

      <sr-tabs
        className="mt-3 h-44"
        orientation="y"
        items="{{verticalTabs}}"
        value="{{verticalValue}}"
        size="sm"
        radius="lg"
        bind:change="handleVerticalChange"
      >
        <sr-tab-panel
          value="tab-a"
          activeValue="{{verticalValue}}"
          className="h-full rounded-2xl border border-slate-200 bg-white p-4 text-sm"
        >
          Panel for Tab A
        </sr-tab-panel>
        <sr-tab-panel
          value="tab-b"
          activeValue="{{verticalValue}}"
          className="h-full rounded-2xl border border-slate-200 bg-white p-4 text-sm"
        >
          Panel for Tab B
        </sr-tab-panel>
        <sr-tab-panel
          value="tab-c"
          activeValue="{{verticalValue}}"
          className="h-full rounded-2xl border border-slate-200 bg-white p-4 text-sm"
        >
          Panel for Tab C (disabled tab)
        </sr-tab-panel>
      </sr-tabs>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Colors</view>
      <view class="mt-1 text-xs text-slate-500">use 2 sm ButtonGroup to switch color</view>

      <view class="mt-3 flex flex-col gap-2">
        <block
          wx:for="{{colorGroups}}"
          wx:for-item="group"
          wx:for-index="groupIndex"
          wx:key="groupIndex"
        >
          <sr-button-group size="sm" isBlock>
            <block wx:for="{{group}}" wx:for-item="option" wx:key="value">
              <sr-button
                class="flex-1"
                color="{{activeColor === option.value ? option.value : 'default'}}"
                variant="{{activeColor === option.value ? 'solid' : 'flat'}}"
                data-color="{{option.value}}"
                bind:tap="handleColorTap"
              >
                {{option.label}}
              </sr-button>
            </block>
          </sr-button-group>
        </block>
      </view>

      <sr-tabs
        className="mt-3"
        items="{{colorTabs}}"
        value="{{colorValue}}"
        color="{{activeColor}}"
        bind:change="handleColorChange"
      />

      <view class="mt-2 text-xs text-slate-500">
        Color: {{activeColor}} / Selected: {{colorValue}}
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Tabs Only</view>
      <view class="mt-1 text-xs text-slate-500">
        external custom panel (e.g. swiper / business container)
      </view>

      <sr-tabs
        className="mt-3"
        items="{{customPanelTabs}}"
        value="{{customValue}}"
        size="md"
        radius="md"
        bind:change="handleCustomChange"
      />

      <view class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-600">
        <view wx:if="{{customValue === 'tab-1'}}">External Panel: Tab 1</view>
        <view wx:elif="{{customValue === 'tab-2'}}">External Panel: Tab 2</view>
        <view wx:else>External Panel: Tab 3</view>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Long List</view>
      <view class="mt-1 text-xs text-slate-500">virtualized tabs + edge tap auto shift</view>

      <sr-tabs
        className="mt-3"
        items="{{longTabs}}"
        value="{{longValue}}"
        radius="full"
        estimateSize="{{88}}"
        bind:change="handleLongChange"
      />

      <view class="mt-2 text-xs text-slate-500">
        Selected: {{longValue}}
      </view>
    </view>
  </view>
</view>
