<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 bg-white border-b border-slate-200">
    <view class="p-4">
      <view class="text-lg font-semibold">Cascader</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view>
      <view class="rounded-2xl bg-white p-4 shadow-sm">
        <view class="text-sm font-semibold">Basic</view>
        <view class="mt-3">
          <sr-cascader
            label="地区"
            options="{{options}}"
            value="{{value}}"
            bind:valuechange="handleValueChange"
          />
        </view>
      </view>
    </view>

    <view>
      <view class="rounded-2xl bg-white p-4 shadow-sm">
        <view class="text-sm font-semibold">Colors</view>
        <view class="mt-3 space-y-3">
          <view>
            <sr-cascader
              label="Default"
              options="{{options}}"
              defaultValue="{{['zj','hz','xh']}}"
            />
          </view>
          <view>
            <sr-cascader
              label="Primary"
              color="primary"
              options="{{options}}"
              defaultValue="{{['gd','sz','ns']}}"
            />
          </view>
          <view>
            <sr-cascader
              label="Success"
              color="success"
              options="{{options}}"
              defaultValue="{{['gd','gz','th']}}"
            />
          </view>
        </view>
      </view>
    </view>

    <view>
      <view class="rounded-2xl bg-white p-4 shadow-sm">
        <view class="text-sm font-semibold">Sizes</view>
        <view class="mt-3 space-y-3">
          <view>
            <sr-cascader
              size="sm"
              label="Small"
              options="{{options}}"
              defaultValue="{{['zj','hz','xh']}}"
            />
          </view>
          <view>
            <sr-cascader
              size="md"
              label="Medium"
              options="{{options}}"
              defaultValue="{{['zj','nb','jb']}}"
            />
          </view>
          <view>
            <sr-cascader
              size="lg"
              label="Large"
              options="{{options}}"
              defaultValue="{{['gd','sz','ft']}}"
            />
          </view>
        </view>
      </view>
    </view>

    <view>
      <view class="rounded-2xl bg-white p-4 shadow-sm">
        <view class="text-sm font-semibold">States</view>
        <view class="mt-3 space-y-3">
          <view>
            <sr-cascader
              label="Disabled"
              isDisabled="{{true}}"
              options="{{options}}"
              defaultValue="{{['zj','hz','xh']}}"
            />
          </view>
          <view>
            <sr-cascader
              label="Read Only"
              isReadOnly="{{true}}"
              options="{{options}}"
              defaultValue="{{['gd','sz','ns']}}"
            />
          </view>
          <view>
            <sr-cascader
              label="Invalid"
              isInvalid="{{true}}"
              errorMessage="请选择有效地区"
              options="{{options}}"
              defaultValue="{{['gd','gz','th']}}"
            />
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
