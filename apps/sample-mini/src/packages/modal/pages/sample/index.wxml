<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 bg-white border-b border-slate-200">
    <view class="p-4">
      <view class="text-lg font-semibold">Modal</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Basic</view>
      <view class="mt-3 flex flex-wrap gap-3">
        <s-button bind:tap="openBasic">Open Modal</s-button>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Backdrop</view>
      <view class="mt-3 flex flex-wrap gap-2">
        <s-button data-backdrop="opaque" variant="outline" bind:tap="openBackdrop">
          Opaque
        </s-button>
        <s-button data-backdrop="blur" variant="outline" bind:tap="openBackdrop">
          Blur
        </s-button>
        <s-button data-backdrop="transparent" variant="outline" bind:tap="openBackdrop">
          Transparent
        </s-button>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Non Dismissable</view>
      <view class="mt-3 flex flex-wrap gap-3">
        <s-button bind:tap="openLocked">Open Locked</s-button>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">No Backdrop</view>
      <view class="mt-3 flex flex-wrap gap-3">
        <s-button bind:tap="openNoBackdrop">Open Modal</s-button>
      </view>
    </view>
  </view>

  <sr-modal
    isOpen="{{basicOpen}}"
    bind:openchange="handleBasicChange"
  >
    <view slot="header">Basic Modal</view>
    <view slot="body">This is a basic modal message.</view>
    <view slot="footer" class="flex items-center justify-end gap-2">
      <s-button variant="text" bind:tap="closeBasic">Cancel</s-button>
      <s-button bind:tap="closeBasic">Confirm</s-button>
    </view>
  </sr-modal>

  <sr-modal
    isOpen="{{backdropOpen}}"
    backdrop="{{backdropValue}}"
    bind:openchange="handleBackdropChange"
  >
    <view slot="header">Backdrop: {{backdropValue}}</view>
    <view slot="body">Switch between backdrop styles.</view>
    <view slot="footer" class="flex items-center justify-end gap-2">
      <s-button variant="text" bind:tap="closeBackdrop">Close</s-button>
    </view>
  </sr-modal>

  <sr-modal
    isOpen="{{lockedOpen}}"
    isDismissable="{{false}}"
    bind:openchange="handleLockedChange"
  >
    <view slot="header">Locked Modal</view>
    <view slot="body">Backdrop clicks are disabled. Use the button to close.</view>
    <view slot="footer" class="flex items-center justify-end gap-2">
      <s-button variant="text" bind:tap="closeLocked">Close</s-button>
    </view>
  </sr-modal>

  <sr-modal
    isOpen="{{noBackdropOpen}}"
    hasBackdrop="{{false}}"
    bind:openchange="handleNoBackdropChange"
  >
    <view slot="header">No Backdrop</view>
    <view slot="body">Modal without a backdrop.</view>
    <view slot="footer" class="flex items-center justify-end gap-2">
      <s-button variant="text" bind:tap="closeNoBackdrop">Close</s-button>
    </view>
  </sr-modal>
</view>
