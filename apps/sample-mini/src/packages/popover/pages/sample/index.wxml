<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 bg-white border-b border-slate-200">
    <view class="p-4">
      <view class="text-lg font-semibold">Popover</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Basic</view>
      <view class="mt-3">
        <sr-popover
          title="配送说明"
          content="支持工作日与周末配送。"
          isOpen="{{isOpen}}"
          bind:change="handleChange"
        >
          <button slot="trigger">点击查看</button>
        </sr-popover>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Placements</view>
      <view class="mt-6 grid grid-cols-2 gap-6">
        <view>
          <sr-popover placement="top" title="Top" content="顶部展示">
            <button slot="trigger">Top</button>
          </sr-popover>
        </view>
        <view>
          <sr-popover placement="bottom" title="Bottom" content="底部展示">
            <button slot="trigger">Bottom</button>
          </sr-popover>
        </view>
        <view>
          <sr-popover placement="left" title="Left" content="左侧展示">
            <button slot="trigger">Left</button>
          </sr-popover>
        </view>
        <view>
          <sr-popover placement="right" title="Right" content="右侧展示">
            <button slot="trigger">Right</button>
          </sr-popover>
        </view>
      </view>
    </view>
  </view>
</view>
