<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 border-b border-slate-200 bg-white">
    <view class="p-4">
      <view class="text-lg font-semibold">Card</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view>
      <sr-card
        title="订单信息"
        description="2026-02-18 10:30"
        hasFooter="{{true}}"
        isHeaderDivider="{{true}}"
        isFooterDivider="{{true}}"
      >
        <view class="space-y-2 text-sm text-slate-600">
          <view>订单号：A20260218001</view>
          <view>收货人：Srcube</view>
          <view>金额：¥ 168.00</view>
        </view>
        <view slot="footer" class="flex gap-2">
          <sr-button size="sm" variant="flat">取消</sr-button>
          <sr-button size="sm" color="primary">确认</sr-button>
        </view>
      </sr-card>
    </view>

    <view>
      <sr-card
        title="无边框样式"
        description="适用于强调块内容"
        shadow="none"
        isBordered="{{false}}"
        radius="lg"
        className="bg-slate-900 text-white"
        classNames="{{darkClassNames}}"
      >
        <view class="text-sm text-slate-300">Card body content</view>
      </sr-card>
    </view>

    <view>
      <view class="space-y-3">
        <view>
          <sr-card title="Small" size="sm">
            <view class="text-sm text-slate-600">size=sm</view>
          </sr-card>
        </view>
        <view>
          <sr-card title="Medium" size="md">
            <view class="text-sm text-slate-600">size=md</view>
          </sr-card>
        </view>
        <view>
          <sr-card title="Large" size="lg" shadow="md">
            <view class="text-sm text-slate-600">size=lg</view>
          </sr-card>
        </view>
      </view>
    </view>
  </view>
</view>
