<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 border-b border-slate-200 bg-white">
    <view class="p-4">
      <view class="text-lg font-semibold">Stepper</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Basic</view>
      <view class="mt-1 text-xs text-slate-500">field 负责表现层，stepper 只负责数值步进逻辑</view>

      <sr-stepper
        className="mt-3"
        label="Quantity"
        description="Use +/- or input number"
        value="{{basicValue}}"
        min="{{0}}"
        max="{{10}}"
        step="{{0.5}}"
        precision="{{1}}"
        bind:change="handleBasicChange"
      />

      <view class="mt-2 text-xs text-slate-500">Value: {{basicValue}}</view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Label Placement</view>
      <view class="mt-1 text-xs text-slate-500">outside / outside-left / inside</view>

      <view class="mt-3 space-y-3">
        <view>
          <sr-stepper
            label="Outside"
            labelPlacement="outside"
            defaultValue="{{2}}"
            min="{{0}}"
            max="{{9}}"
          />
        </view>
        <view>
          <sr-stepper
            label="Left"
            labelPlacement="outside-left"
            defaultValue="{{2}}"
            min="{{0}}"
            max="{{9}}"
          />
        </view>
        <view>
          <sr-stepper
            label="Inside"
            labelPlacement="inside"
            defaultValue="{{2}}"
            min="{{0}}"
            max="{{9}}"
          />
        </view>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Variants</view>
      <view class="mt-1 text-xs text-slate-500">default / outline / twotone / underline</view>

      <view class="mt-3 space-y-3">
        <sr-stepper label="Default" defaultValue="{{2}}" variant="default" />
        <sr-stepper label="Outline" defaultValue="{{2}}" variant="outline" />
        <sr-stepper label="Twotone" defaultValue="{{2}}" variant="twotone" />
        <sr-stepper label="Underline" defaultValue="{{2}}" variant="underline" />
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Sizes</view>
      <view class="mt-1 text-xs text-slate-500">sm / md / lg</view>

      <view class="mt-3 space-y-3">
        <sr-stepper label="Small" defaultValue="{{2}}" size="sm" />
        <sr-stepper label="Medium" defaultValue="{{2}}" size="md" />
        <sr-stepper label="Large" defaultValue="{{2}}" size="lg" />
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Radius</view>
      <view class="mt-1 text-xs text-slate-500">none / sm / md / lg / full</view>

      <view class="mt-3 space-y-3">
        <sr-stepper label="Radius None" defaultValue="{{2}}" variant="twotone" radius="none" />
        <sr-stepper label="Radius Sm" defaultValue="{{2}}" variant="twotone" radius="sm" />
        <sr-stepper label="Radius Md" defaultValue="{{2}}" variant="twotone" radius="md" />
        <sr-stepper label="Radius Lg" defaultValue="{{2}}" variant="twotone" radius="lg" />
        <sr-stepper label="Radius Full" defaultValue="{{2}}" variant="twotone" radius="full" />
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">States</view>
      <view class="mt-1 text-xs text-slate-500">invalid / disabled / readOnly</view>

      <view class="mt-3 space-y-3">
        <sr-stepper
          label="Invalid"
          value="{{12}}"
          min="{{0}}"
          max="{{9}}"
          variant="outline"
          color="danger"
          errorMessage="数值超出范围"
          isInvalid
        />
        <sr-stepper
          label="Disabled"
          defaultValue="{{3}}"
          description="disabled state"
          isDisabled
        />
        <sr-stepper
          label="Readonly"
          defaultValue="{{3}}"
          description="readonly state"
          isReadOnly
        />
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Colors</view>
      <view class="mt-1 text-xs text-slate-500">use 2 sm ButtonGroup to switch color</view>

      <view class="mt-3 flex flex-col gap-2">
        <block
          wx:for="{{colorGroups}}"
          wx:for-item="group"
          wx:for-index="groupIndex"
          wx:key="groupIndex"
        >
          <sr-button-group size="sm" isBlock>
            <block wx:for="{{group}}" wx:for-item="option" wx:key="value">
              <sr-button
                class="flex-1"
                color="{{activeColor === option.value ? option.value : 'default'}}"
                variant="{{activeColor === option.value ? 'solid' : 'flat'}}"
                data-color="{{option.value}}"
                bind:tap="handleColorTap"
              >
                {{option.label}}
              </sr-button>
            </block>
          </sr-button-group>
        </block>
      </view>

      <sr-stepper
        className="mt-3"
        label="Color Preview"
        color="{{activeColor}}"
        value="{{colorValue}}"
        min="{{0}}"
        max="{{9}}"
        bind:change="handleColorChange"
      />

      <view class="mt-2 text-xs text-slate-500">Color: {{activeColor}}</view>
    </view>
  </view>
</view>
