<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 bg-white border-b border-slate-200">
    <view class="p-4">
      <view class="text-lg font-semibold">Avatar</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Basic</view>
      <view class="mt-3 flex items-center gap-3">
        <sr-avatar name="Srcube User" />
        <sr-avatar name="Taylor Swift" color="primary" />
        <sr-avatar icon="?" color="warning" />
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Image / Sizes</view>
      <view class="mt-3 flex items-end gap-3">
        <sr-avatar size="sm" src="{{avatarUrl}}" />
        <sr-avatar size="md" src="{{avatarUrl}}" />
        <sr-avatar size="lg" src="{{avatarUrl}}" />
        <sr-avatar size="xl" src="{{avatarUrl}}" isBordered="{{true}}" />
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Radius</view>
      <view class="mt-3 flex items-center gap-3">
        <sr-avatar radius="none" name="RN" />
        <sr-avatar radius="sm" name="RS" />
        <sr-avatar radius="md" name="RM" />
        <sr-avatar radius="lg" name="RL" />
        <sr-avatar radius="full" name="RF" />
      </view>
    </view>
  </view>
</view>
