<view class="min-h-screen bg-slate-100 text-slate-900 pb-safe">
  <view class="sticky top-0 z-20 bg-white border-b border-slate-200">
    <view class="p-4">
      <view class="text-lg font-semibold">Scrollbox</view>
    </view>
  </view>

  <view class="p-4 space-y-6">
    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Vertical</view>
      <view class="mt-3 h-56">
        <sr-scrollbox
          orientation="y"
          className="h-full rounded-2xl border border-slate-200 bg-white"
        >
          <view class="space-y-3 p-4">
            <view
              wx:for="{{items}}"
              wx:key="id"
              class="flex items-center justify-center h-12 rounded-xl bg-slate-100 px-4 text-sm font-semibold text-slate-700"
            >
              {{item.label}}
            </view>
          </view>
        </sr-scrollbox>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Horizontal</view>
      <view class="mt-3">
        <sr-scrollbox
          orientation="x"
          className="h-fit rounded-2xl border border-slate-200 bg-white"
        >
          <view class="flex gap-3 p-4">
            <view
              wx:for="{{cards}}"
              wx:key="id"
              class="inline-flex h-16 w-32 items-center justify-center rounded-xl bg-slate-100 text-sm font-semibold text-slate-700"
            >
              {{item.label}}
            </view>
          </view>
        </sr-scrollbox>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Both (xy)</view>
      <view class="mt-3 h-48">
        <sr-scrollbox
          orientation="xy"
          className="h-full rounded-2xl border border-slate-200 bg-white"
        >
          <view class="grid w-[520px] h-[320px] grid-cols-4 gap-3 p-4">
            <view
              wx:for="{{items}}"
              wx:key="id"
              class="flex h-full items-center justify-center rounded-xl bg-slate-100 text-xs font-semibold text-slate-700"
            >
              {{item.label}}
            </view>
          </view>
        </sr-scrollbox>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Hide Masks</view>
      <view class="mt-3 h-48">
        <sr-scrollbox
          hideMasks
          className="h-full rounded-2xl border border-slate-200 bg-white"
        >
          <view class="flex flex-col space-y-3 p-4">
            <view
              wx:for="{{items}}"
              wx:key="id"
              class="flex items-center justify-center h-10 rounded-xl bg-slate-100 px-4 text-sm font-semibold text-slate-700"
            >
              {{item.label}}
            </view>
          </view>
        </sr-scrollbox>
      </view>
    </view>

    <view class="rounded-2xl bg-white p-4 shadow-sm">
      <view class="text-sm font-semibold">Show Scrollbar</view>
      <view class="mt-3 h-48">
        <sr-scrollbox
          showScrollbar
          className="h-full rounded-2xl border border-slate-200 bg-white"
        >
          <view class="flex flex-col space-y-3 p-4">
            <view
              wx:for="{{items}}"
              wx:key="id"
              class="flex items-center justify-center h-10 rounded-xl bg-slate-100 px-4 text-sm font-semibold text-slate-700"
            >
              {{item.label}}
            </view>
          </view>
        </sr-scrollbox>
      </view>
    </view>
  </view>
</view>
