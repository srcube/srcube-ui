<view class="sr-accordion {{$classNames.base}}" style="{{style}}">
  <view
    wx:for="{{$renderItems}}"
    wx:key="key"
    class="sr-accordion__item {{$classNames.item}} {{item.itemClassName}}"
  >
    <button
      class="sr-accordion__trigger {{$classNames.trigger}}"
      data-index="{{item.index}}"
      bindtap="handleItemTap"
      disabled="{{item.isItemDisabled}}"
      type="default"
      plain="{{true}}"
      hover-class="none"
    >
      <text class="sr-accordion__title {{$classNames.title}}">{{item.title}}</text>
      <text
        wx:if="{{hasIndicator}}"
        class="sr-accordion__icon {{$classNames.icon}} {{item.iconClassName}}"
      >
        v
      </text>
    </button>

    <view wx:if="{{item.isExpanded}}" class="sr-accordion__panel {{$classNames.panel}}">
      <view class="sr-accordion__content {{$classNames.content}}">
        <text>{{item.content}}</text>
      </view>
    </view>
  </view>
</view>
