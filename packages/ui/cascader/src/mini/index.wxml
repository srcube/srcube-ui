<view class="sr-cascader {{$classNames.base}} {{className}}" style="{{style}}">
  <sr-picker
    class="sr-cascader__picker {{$classNames.$picker}}"
    className="{{$classNames.picker}}"
    classNames="{{pickerClassNames}}"
    id="{{id}}"
    label="{{label}}"
    labelPlacement="{{labelPlacement}}"
    placeholder="{{placeholder}}"
    description="{{description}}"
    errorMessage="{{errorMessage}}"
    color="{{color}}"
    variant="{{variant}}"
    size="{{size}}"
    radius="{{radius}}"
    type="{{type}}"
    columns="{{$resolvedColumns}}"
    value="{{$resolvedValue}}"
    isOpen="{{isOpen}}"
    defaultOpen="{{defaultOpen}}"
    separator="{{separator}}"
    confirmText="{{confirmText}}"
    drawerTitle="{{drawerTitle || label || ''}}"
    isDismissable="{{isDismissable}}"
    hasBackdrop="{{hasBackdrop}}"
    backdrop="{{backdrop}}"
    estimateSize="{{estimateSize}}"
    overscan="{{overscan}}"
    indicatorHeight="{{indicatorHeight}}"
    scrollEndDelay="{{scrollEndDelay}}"
    isDisabled="{{isDisabled}}"
    isReadOnly="{{isReadOnly}}"
    isInvalid="{{isInvalid}}"
    isRequired="{{isRequired}}"
    isLoading="{{isLoading}}"
    bind:tap="handlePickerTap"
    bind:openchange="handlePickerOpenChange"
    bind:cancel="handlePickerCancel"
    bind:draftvaluechange="handlePickerDraftValueChange"
    bind:valuechange="handlePickerValueChange"
  />
</view>
