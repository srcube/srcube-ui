<view id="{{id}}" class="sr-navbar {{$classNames.base}}" style="{{style}}">
  <view class="sr-navbar__inner {{$classNames.inner}}">
    <view class="sr-navbar__start {{$classNames.start}}">
      <slot name="start">
        <view
          wx:if="{{withBack}}"
          class="sr-navbar__back {{$classNames.back}}"
          bind:tap="handleBackTap"
        >
          <text class="sr-navbar__back-icon {{$classNames.backIcon}}" />
        </view>
      </slot>
    </view>
    <view class="sr-navbar__title {{$classNames.title}}">
      <slot name="title">{{title}}</slot>
    </view>
    <view class="sr-navbar__end {{$classNames.end}}">
      <slot name="end" />
    </view>
  </view>
</view>
