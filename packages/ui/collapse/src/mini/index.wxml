<view class="sr-collapse {{$classNames.base}}" style="{{style}}">
  <button
    class="sr-collapse__trigger {{$classNames.trigger}}"
    bindtap="handleTriggerTap"
    disabled="{{isDisabled}}"
    type="default"
    plain="{{true}}"
    hover-class="none"
  >
    <text class="sr-collapse__title {{$classNames.title}}">{{title}}</text>
    <text wx:if="{{hasIndicator}}" class="sr-collapse__icon {{$classNames.icon}}">
      v
    </text>
  </button>

  <view wx:if="{{$isExpanded}}" class="sr-collapse__panel {{$classNames.panel}}">
    <view class="sr-collapse__content {{$classNames.content}}">
      <text wx:if="{{content}}">{{content}}</text>
      <slot />
    </view>
  </view>
</view>
