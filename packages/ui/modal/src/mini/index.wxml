<view
  wx:if="{{isVisible}}"
  class="sr-modal__root {{$classNames.rootPortal}} {{className}}"
  style="{{style}}"
>
  <view
    wx:if="{{hasBackdrop}}"
    class="sr-modal__backdrop {{$classNames.backdrop}}"
    bindtap="handleBackdropTap"
    catchtouchmove="handleTouchMoveCapture"
  />
  <view class="sr-modal__content {{$classNames.content}}">
    <view class="sr-modal__header {{$classNames.header}}">
      <slot name="header" />
    </view>
    <view class="sr-modal__body {{$classNames.body}}">
      <slot name="body">
        <slot />
      </slot>
    </view>
    <view class="sr-modal__footer {{$classNames.footer}}">
      <slot name="footer" />
    </view>
  </view>
</view>
