<view
  wx:if="{{$renderToasts.length > 0}}"
  class="sr-toaster {{$classNames.base}}"
  style="{{style}}"
>
  <view class="sr-toaster__stack {{$classNames.stack}}">
    <block wx:for="{{$renderToasts}}" wx:key="id" wx:for-item="item">
      <view class="sr-toaster__item {{item.classes.layer}}" style="{{item.layerStyle}}">
        <view class="sr-toaster__card {{item.classes.toast}}">
          <view class="sr-toaster__icon {{item.classes.icon}}">
            <text wx:if="{{item.icon}}">{{item.icon}}</text>
            <view wx:else class="{{item.classes._iIcon}}" />
          </view>

          <view class="sr-toaster__text-wrap {{item.classes.textWrap}}">
            <text wx:if="{{item.title}}" class="sr-toaster__title {{item.classes.title}}">
              {{item.title}}
            </text>
            <text
              wx:if="{{item.description}}"
              class="sr-toaster__description {{item.classes.description}}"
            >
              {{item.description}}
            </text>
          </view>
        </view>

        <view
          wx:if="{{item.isClosable}}"
          class="sr-toaster__close {{item.classes.closeButton}}"
          data-id="{{item.id}}"
          bindtap="handleCloseTap"
        >
          <view class="{{item.classes._iClose}}" />
        </view>
      </view>
    </block>
  </view>
</view>
