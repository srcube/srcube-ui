<view class="sr-switch__wrapper {{$classNames.base}}" style="{{style}}" bindtap="handleTap">
  <switch
    class="sr-switch__native {{$classNames.nSwitch}}"
    checked="{{$isSelected}}"
    disabled="{{$isDisabled}}"
    color="#00000000"
  />

  <view class="sr-switch__track {{$classNames.track}}">
    <view class="sr-switch__thumb {{$classNames.thumb}}">
      <block wx:if="{{$isLoading}}">
        <view class="{{$classNames._iLoading}}" />
      </block>
      <block wx:elif="{{hasIcon}}">
        <view class="{{$classNames._iThumb}}">
          <slot name="icon" />
        </view>
      </block>
    </view>
  </view>

  <view class="{{$classNames.content}}">
    <slot />
  </view>
</view>
