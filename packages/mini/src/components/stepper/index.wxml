<sr-field
  id="{{id}}"
  label="{{label}}"
  labelPlacement="{{labelPlacement}}"
  value="{{_inputValue}}"
  description="{{description}}"
  errorMessage="{{errorMessage}}"
  color="{{$resolvedColor}}"
  tone="{{tone}}"
  variant="{{$resolvedVariant}}"
  size="{{$resolvedSize}}"
  radius="{{radius}}"
  isDisabled="{{$isDisabled}}"
  isReadOnly="{{$isReadOnly}}"
  isInvalid="{{isInvalid}}"
  isRequired="{{isRequired}}"
  isLoading="{{isLoading}}"
  hasControl="{{true}}"
  hasStartContent="{{true}}"
  hasEndContent="{{true}}"
  className="{{$baseClassName}}"
  style="{{style}}"
  bind:tap="handleFieldTap"
>
  <sr-button
    slot="start"
    className="{{$decrementButtonClassName}}"
    color="{{$resolvedColor}}"
    tone="{{$buttonTone}}"
    variant="text"
    size="{{$resolvedSize}}"
    radius="none"
    isDisabled="{{!$canDecrement}}"
    bind:tap="handleDecreaseTap"
  >
    -
  </sr-button>

  <view class="{{$valueWrapClassName}}">
    <input
      class="{{$inputClassName}}"
      type="text"
      value="{{_inputValue}}"
      disabled="{{$isDisabled || $isReadOnly}}"
      bindinput="handleInput"
      bindblur="handleInputBlur"
    />
  </view>

  <sr-button
    slot="end"
    className="{{$incrementButtonClassName}}"
    color="{{$resolvedColor}}"
    tone="{{$buttonTone}}"
    variant="text"
    size="{{$resolvedSize}}"
    radius="none"
    isDisabled="{{!$canIncrement}}"
    bind:tap="handleIncreaseTap"
  >
    +
  </sr-button>
</sr-field>
