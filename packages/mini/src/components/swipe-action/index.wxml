<view class="sr-swipe-action__base {{$classNames.base}}" style="{{style}}">
  <view
    class="sr-swipe-action__left-actions {{$classNames.actions}} {{$classNames.leftActions}}"
    style="{{$leftGroupStyle}}"
  >
    <sr-button
      wx:for="{{$leftActions}}"
      wx:key="key"
      class="sr-swipe-action__action {{$classNames.action}}"
      className="{{$classNames.actionButton}} {{item.className}}"
      style="{{item.widthStyle}}"
      color="{{item.buttonColor}}"
      tone="{{$resolvedButtonTone}}"
      size="{{$resolvedSize}}"
      radius="none"
      isDisabled="{{isDisabled || item.isDisabled}}"
      data-direction="left"
      data-index="{{index}}"
      bind:tap="handleActionTap"
    >
      <view
        wx:if="{{item.iconClassName}}"
        class="{{$classNames.actionIcon}} {{item.iconClassName}}"
      />
      <view wx:if="{{item.label}}" class="{{$classNames.actionLabel}}">
        {{item.label}}
      </view>
    </sr-button>
  </view>

  <view
    class="sr-swipe-action__right-actions {{$classNames.actions}} {{$classNames.rightActions}}"
    style="{{$rightGroupStyle}}"
  >
    <sr-button
      wx:for="{{$rightActions}}"
      wx:key="key"
      class="sr-swipe-action__action {{$classNames.action}}"
      className="{{$classNames.actionButton}} {{item.className}}"
      style="{{item.widthStyle}}"
      color="{{item.buttonColor}}"
      tone="{{$resolvedButtonTone}}"
      size="{{$resolvedSize}}"
      radius="none"
      isDisabled="{{isDisabled || item.isDisabled}}"
      data-direction="right"
      data-index="{{index}}"
      bind:tap="handleActionTap"
    >
      <view
        wx:if="{{item.iconClassName}}"
        class="{{$classNames.actionIcon}} {{item.iconClassName}}"
      />
      <view wx:if="{{item.label}}" class="{{$classNames.actionLabel}}">
        {{item.label}}
      </view>
    </sr-button>
  </view>

  <view
    class="sr-swipe-action__content {{$classNames.content}}"
    style="{{$contentStyle}}"
    bindtouchstart="handleTouchStart"
    bindtouchmove="handleTouchMove"
    bindtouchend="handleTouchEnd"
    bindtouchcancel="handleTouchCancel"
    bindtap="handleContentTap"
  >
    <slot />
  </view>
</view>
