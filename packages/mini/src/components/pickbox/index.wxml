<view class="sr-pickbox {{$classNames.base}}" style="{{style}}">
  <view class="sr-pickbox__columns {{$classNames.columns}}">
    <view
      wx:for="{{renderColumns}}"
      wx:for-item="column"
      wx:key="id"
      class="sr-pickbox__column {{$classNames.column}}"
    >
      <scroll-view
        class="sr-pickbox__column-scroll {{$classNames.columnScroll}}"
        scroll-y
        scroll-top="{{column.scrollTop}}"
        scroll-with-animation="{{column.scrollWithAnimation}}"
        enhanced="{{true}}"
        show-scrollbar="{{false}}"
        data-column-index="{{column.columnIndex}}"
        binddragstart="handleColumnDragStart"
        binddragging="handleColumnDragging"
        binddragend="handleColumnDragEnd"
        bindtouchstart="handleColumnTouchStart"
        bindtouchmove="handleColumnTouchMove"
        bindtouchend="handleColumnTouchEnd"
        bindtouchcancel="handleColumnTouchCancel"
        bindscroll="handleColumnScroll"
      >
        <view
          class="sr-pickbox__column-content {{$classNames.columnContent}}"
          style="{{column.contentStyle}}"
        >
          <view
            wx:for="{{column.items}}"
            wx:for-item="item"
            wx:key="virtualKey"
            class="sr-pickbox__item {{$classNames.item}} {{item.className}}"
            style="{{item.style}}"
          >
            <text class="{{$classNames.itemLabel}}">{{item.label}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view
    class="sr-pickbox__indicator {{$classNames.indicator}}"
    style="height: {{resolvedIndicatorHeight}}px;"
  />
  <view
    class="sr-pickbox__mask-top {{$classNames.maskTop}}"
    style="position: absolute; left: 0; right: 0; top: 0; height: 33.3333%; z-index: 20; pointer-events: none; background: {{tone === 'dark' ? 'linear-gradient(180deg, rgba(9,9,11,1) 0%, rgba(9,9,11,0.96) 22%, rgba(9,9,11,0.78) 56%, rgba(9,9,11,0.4) 82%, rgba(9,9,11,0) 100%)' : 'linear-gradient(180deg, rgba(255,255,255,1) 0%, rgba(255,255,255,0.96) 22%, rgba(255,255,255,0.78) 56%, rgba(255,255,255,0.4) 82%, rgba(255,255,255,0) 100%)'}};"
  />
  <view
    class="sr-pickbox__mask-bottom {{$classNames.maskBottom}}"
    style="position: absolute; left: 0; right: 0; bottom: 0; height: 33.3333%; z-index: 20; pointer-events: none; background: {{tone === 'dark' ? 'linear-gradient(0deg, rgba(9,9,11,1) 0%, rgba(9,9,11,0.96) 22%, rgba(9,9,11,0.78) 56%, rgba(9,9,11,0.4) 82%, rgba(9,9,11,0) 100%)' : 'linear-gradient(0deg, rgba(255,255,255,1) 0%, rgba(255,255,255,0.96) 22%, rgba(255,255,255,0.78) 56%, rgba(255,255,255,0.4) 82%, rgba(255,255,255,0) 100%)'}};"
  />

  <slot />
</view>
