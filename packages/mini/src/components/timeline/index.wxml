<view id="{{id}}" class="sr-timeline {{$classNames.base}}" style="{{style}}">
  <view class="sr-timeline__list {{$classNames.list}}">
    <block wx:for="{{$renderItems}}" wx:key="key" wx:for-item="item">
      <view class="sr-timeline__item {{item.classes.item}}">
        <view class="sr-timeline__indicator-wrap {{item.classes.indicatorWrap}}">
          <view class="sr-timeline__line-start {{item.classes.lineStart}}" />
          <view class="sr-timeline__node {{item.classes.node}}">
            <view
              wx:if="{{item.iconClass || item.iconText}}"
              class="sr-timeline__icon {{item.classes.icon}} {{item.iconClass}}"
            >
              {{item.iconText}}
            </view>
          </view>
          <view class="sr-timeline__line-end {{item.classes.lineEnd}}" />
        </view>

        <view class="sr-timeline__content {{item.classes.content}}">
          <view class="sr-timeline__title {{item.classes.title}}">{{item.title}}</view>
          <view wx:if="{{item.time}}" class="sr-timeline__time {{item.classes.time}}">
            {{item.time}}
          </view>
          <view
            wx:if="{{item.description}}"
            class="sr-timeline__description {{item.classes.description}}"
          >
            {{item.description}}
          </view>
          <view class="sr-timeline__content-spacer {{item.classes.contentSpacer}}" style="{{item.spacerStyle}}" />
        </view>
      </view>
    </block>
  </view>
</view>
