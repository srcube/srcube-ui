<view class="sr-radio__wrapper {{$classNames.base}}" style="{{style}}" bindtap="handleTap">
  <radio
    class="sr-radio__native {{$classNames.nRadio}}"
    value="{{value}}"
    checked="{{$isSelected}}"
    disabled="{{$isDisabled}}"
  />
  <view class="sr-radio__control {{$classNames.radio}}">
    <view class="{{$classNames.iconWrapper}}">
      <block wx:if="{{$isLoading}}">
        <view class="{{$classNames._iLoading}}" />
      </block>
      <block wx:else>
        <block wx:if="{{hasIcon}}">
          <slot name="icon" />
        </block>
        <block wx:else>
          <view class="{{$classNames.iDefault}}" />
        </block>
      </block>
    </view>
  </view>
  <view class="{{$classNames.content}}">
    <slot />
  </view>
</view>
