<view
  id="{{id}}"
  class="sr-image {{$classNames.base}}"
  style="{{$rootStyle}}"
  bindtap="handlePreviewTap"
>
  <image
    wx:if="{{src}}"
    class="sr-image__image {{$classNames.image}}"
    src="{{src}}"
    mode="{{$imageMode}}"
    bindload="handleImageLoad"
    binderror="handleImageError"
  />
  <view class="sr-image__placeholder {{$classNames.placeholder}}">
    {{$placeholderText}}
  </view>
</view>

<view
  wx:if="{{_previewVisible}}"
  class="sr-image__preview"
  catchtap="handlePreviewSurfaceTap"
  bindtouchstart="handlePreviewTouchStart"
  catchtouchmove="handlePreviewTouchMove"
  bindtouchend="handlePreviewTouchEnd"
  bindtouchcancel="handlePreviewTouchEnd"
>
  <view class="sr-image__preview-mask {{$classNames.previewMask}}" />
  <view class="sr-image__preview-body {{$classNames.previewBody}}">
    <image
      class="sr-image__preview-image {{$classNames.previewImage}}"
      style="{{$previewImageStyle}}"
      src="{{$previewCurrent}}"
      mode="aspectFit"
      bindload="handlePreviewImageLoad"
    />
  </view>
</view>
