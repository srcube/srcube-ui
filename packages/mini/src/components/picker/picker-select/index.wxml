<view class="sr-picker-select__base {{$classNames.base}} {{className}}" style="{{style}}">
  <sr-field
    class="sr-picker-select__field {{$classNames.$field}}"
    className="{{$classNames.field}}"
    id="{{id}}"
    label="{{label}}"
    labelPlacement="{{labelPlacement}}"
    value="{{$displayValue}}"
    placeholder="{{placeholder}}"
    description="{{description}}"
    errorMessage="{{errorMessage}}"
    color="{{$resolvedColor}}"
    tone="{{$resolvedTone}}"
    variant="{{variant}}"
    size="{{$resolvedSize}}"
    radius="{{radius}}"
    isDisabled="{{isDisabled}}"
    isReadOnly="{{isReadOnly}}"
    isInvalid="{{isInvalid}}"
    isRequired="{{isRequired}}"
    isLoading="{{isLoading}}"
    bind:tap="handleFieldTap"
  />

  <sr-drawer
    class="sr-picker-select__drawer {{$classNames.$drawer}}"
    className="{{$classNames.drawer}}"
    classNames="{{$drawerClassNames}}"
    isOpen="{{$resolvedOpen}}"
    placement="bottom"
    title="{{drawerTitle || label || ''}}"
    isDismissable="{{isDismissable}}"
    hasBackdrop="{{hasBackdrop}}"
    tone="{{$resolvedTone}}"
    backdrop="{{backdrop}}"
    bind:openchange="handleDrawerOpenChange"
  >
    <view slot="header" class="{{$classNames.drawerTitle}}">
      {{drawerTitle || label || ''}}
    </view>

    <view slot="body">
      <sr-selectbox
        wx:if="{{$resolvedOpen}}"
        class="sr-picker-select__selectbox {{$classNames.$pickbox}}"
        className="{{$classNames.pickbox}}"
        size="{{$resolvedSize}}"
        color="{{$resolvedColor}}"
        tone="{{$resolvedTone}}"
        selectionMode="{{selectionMode}}"
        selectIcon="{{true}}"
        items="{{$resolvedItems}}"
        value="{{_draftValue}}"
        estimateSize="{{estimateSize}}"
        overscan="{{overscan}}"
        listboxClassNames="{{$selectboxListboxClassNames}}"
        hasDivider
        bind:valuechange="handleSelectboxValueChange"
      />
    </view>

    <view slot="footer">
      <sr-button
        class="sr-picker-select__confirm {{$classNames.$confirmButton}}"
        className="{{$classNames.confirmButton}}"
        color="{{$resolvedColor}}"
        tone="{{$buttonTone}}"
        size="{{$resolvedSize}}"
        variant="flat"
        isBlock
        isDisabled="{{$isConfirmDisabled}}"
        bind:tap="handleConfirmTap"
      >
        {{$confirmText}}
      </sr-button>
    </view>
  </sr-drawer>
</view>
