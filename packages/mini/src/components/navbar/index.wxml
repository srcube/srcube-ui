<view class="sr-navbar {{$classNames.base}}" style="{{style}}">
  <view wx:if="{{hasSafeTop}}" class="sr-navbar__safe-top" style="height: {{_safeTopHeight}}px;"></view>
  <view class="sr-navbar__inner {{$classNames.inner}}" style="padding-left: {{_sideInset}}px; padding-right: {{_sideInset}}px; min-height: {{_capsuleHeight}}px;">
    <view class="sr-navbar__start {{$classNames.start}}">
      <view
        wx:if="{{withBack}}"
        class="sr-navbar__back {{$classNames.back}}"
        bind:tap="handleBackTap"
      >
        <view class="sr-navbar__back-icon {{$classNames.iBack}}" />
      </view>
      <view wx:else class="sr-navbar__placeholder {{$classNames.placeholder}}" />
      <slot name="start" />
    </view>
    <view class="sr-navbar__title {{$classNames.title}}">
      {{title}}
    </view>
    <view class="sr-navbar__end {{$classNames.end}}">
      <slot name="end" />
      <view class="sr-navbar__capsule-placeholder" style="width: {{_capsuleWidth}}px; height: {{_capsuleHeight}}px;"></view>
    </view>
  </view>
</view>
